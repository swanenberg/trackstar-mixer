<!--
Description:
  A deck container
  * main deck
    * artist/title
    * overview
    * track comment (if enabled)
    * deck buttons
  * mixer / [CoverArt/Spinny]
  * VU meter
Variables:
  chanNum : [ChannelN]
-->
<Template>
  <SetVariable name="group">[Channel<Variable name="chanNum"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>DeckContainer</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <WidgetGroup><!-- [Comment, ArtistTitle] + [Overview onderaan] -->
        <ObjectName>Deck<Variable name="chanNum"/></ObjectName>
        <SizePolicy>me,me</SizePolicy>
        <Layout>vertical</Layout>
        <Children>

          <!-- Ruimte boven -->
          <WidgetGroup><Size>1min,1me</Size></WidgetGroup>

          <!-- Titel/artiest + waveform, tegen elkaar -->
          <WidgetGroup>
            <Layout>vertical</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>

              <WidgetGroup><!-- Artist + Time -->
                <Layout>horizontal</Layout>
                <SizePolicy>me,min</SizePolicy>
                <Children>
                  <Template src="skin:/decks/row_text_left.xml"/>
                  <Template src="skin:/decks/loop_indicator.xml"/>
                </Children>
              </WidgetGroup>

              <WidgetGroup><!-- overview-waveform direct onder de tekst -->
                <Layout>horizontal</Layout>
                <Size>250me,40f</Size>
                <Children>
                  <Template src="skin:/decks/row_overview_left.xml"/>
                </Children>
              </WidgetGroup>

            </Children>
          </WidgetGroup>

          <!-- Ruimte onder -->
          <WidgetGroup><Size>1min,1me</Size></WidgetGroup>

        </Children>
      </WidgetGroup><!-- / [Overview, Comment, ArtistTitle] + [Loop/Beatjump, DeckButtons] -->

      <WidgetGroup><!-- Spinny/Cover + VUMeter -->
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>

          <!-- Spinny/Cover if BIG spinny is enabled -->
          <WidgetGroup>
            <ObjectName>AlignTop</ObjectName>
            <SizePolicy>max,min</SizePolicy>
            <Layout>horizontal</Layout>
            <Children>

              <!-- 3px margin to main deck -->
              <WidgetGroup>
                <Size>3f,1min</Size>
                <Connection>
                  <ConfigKey persist="true">[Tango],show_spinny_cover</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>

              <Template src="skin:/decks/spinny_cover_maxi.xml">
                <SetVariable name="chanNum"><Variable name="chanNum"/></SetVariable>
              </Template>

            </Children>
            <Connection>
              <ConfigKey persist="true">[Skin],show_big_spinny_coverart</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup><!-- /Spinny/Cover if BIG spinny is enabled -->

        </Children>
        <Connection>
          <ConfigKey persist="true">[Skin],show_mixer</ConfigKey>
          <Transform><Not/></Transform>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup><!-- /Spinny + VUMeter -->

      <WidgetGroup><!-- Mixer -->
        <Layout>vertical</Layout>
        <SizePolicy>f,min</SizePolicy>
        <Children>
          <Template src="skin:/mixer/mixer_channel_left.xml"/>
          <WidgetGroup><ObjectName>Spacer1e</ObjectName><Size>0min,0me</Size></WidgetGroup>
        </Children>
        <Connection>
          <ConfigKey persist="true">[Skin],show_mixer</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup><!-- /Mixer -->

      <!-- Pitch slider & Key controls -->
      <WidgetGroup>
        <Size>3f,1min</Size>
        <Connection>
          <ConfigKey persist="true">[Skin],show_rate_controls</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>

      <Template src="skin:/decks/rate_pitch_key.xml"/>
      <!-- /Pitch slider & Key controls -->

      <WidgetGroup><!-- VUMeter -->
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>

          <WidgetGroup>
            <SizePolicy>min,min</SizePolicy>
            <Layout>horizontal</Layout>
            <Children>
              <WidgetGroup><Size>3f,1min</Size></WidgetGroup>
              <Template src="skin:/mixer/vumeter_floating.xml">
                <SetVariable name="Label">Deck<Variable name="chanNum"/></SetVariable>
              </Template>
            </Children>
            <Connection>
              <ConfigKey persist="true">[Tango],vumeter</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>

        </Children>
        <Connection>
          <ConfigKey persist="true">[Skin],show_mixer</ConfigKey>
          <Transform><Not/></Transform>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup><!-- /VUMeter -->

      <WidgetGroup><Size>5f,1min</Size></WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
