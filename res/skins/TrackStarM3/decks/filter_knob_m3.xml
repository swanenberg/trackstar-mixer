<!--
  Filterknop (QuickEffect super) van deck <chanNum> in de crossfader-balk (Brecht 07-10).
Variables: chanNum
-->
<Template>
  <WidgetGroup>
    <ObjectName>FilterKnobBox</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>min,min</SizePolicy>
    <MinimumSize>64,66</MinimumSize>
    <MaximumSize>64,66</MaximumSize>
    <Children>
      <WidgetGroup><Size>1min,8f</Size></WidgetGroup>
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <WidgetGroup><Size>1me,1min</Size></WidgetGroup>
          <KnobComposed>
            <TooltipId>QuickEffectRack_super1</TooltipId>
            <Size>40f,40f</Size>
            <Knob>skin:/knobs_sliders/knob_m3.svg</Knob>
            <BackPath>skin:/knobs_sliders/knob_bg_m3.svg</BackPath>
            <MinAngle>-130</MinAngle>
            <MaxAngle>130</MaxAngle>
            <Connection>
              <ConfigKey>[QuickEffectRack1_[Channel<Variable name="chanNum"/>]],super1</ConfigKey>
            </Connection>
          </KnobComposed>
          <WidgetGroup><Size>1me,1min</Size></WidgetGroup>
        </Children>
      </WidgetGroup>
      <Label><ObjectName>FxKicker</ObjectName><Text>FILTER</Text><Size>64f,16f</Size></Label>
    </Children>
  </WidgetGroup>
</Template>
