WCoverArtMenu,
WCoverArtMenu::item,
WCueMenuPopup,
WCueMenuPopup QLabel,
#SkinSettings,
#SkinSettingsLabel,
#SkinSettingsButton,
#SkinSettingsButtonMulti,
WEffectSelector,
