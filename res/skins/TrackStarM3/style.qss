  }
QToolTip,
#MainMenu QMenu,
WLibrarySidebar QMenu,
WTrackTableViewHeader QMenu,
WLibraryTextBrowser QMenu,
WTrackMenu,
WTrackMenu QMenu,
QLineEdit QMenu,
QPlainTextEdit QMenu,
WCueMenuPopup,
WCoverArtMenu,
WEffectSelector QAbstractScrollArea,
WEffectChainPresetButton QMenu,
WEffectChainPresetSelector QAbstractScrollArea,
WSearchLineEdit QAbstractScrollArea,
#fadeModeCombobox QAbstractScrollArea {
  border: 1px solid #C4C6D0;
  border-radius: 2px;
  }
  #SkinSettings {
    qproperty-layoutAlignment: 'AlignLeft | AlignTop';
    margin: 1px 0px 1px 1px;
    padding-left: 5px;
    border-right: 0px;
  }

/* selected / hovered menu items */
#MainMenu::item:selected,
#MainMenu QMenu::item:selected,
#MainMenu QMenu::item:focus,
#MainMenu QMenu::item:hover,
#MainMenu QMenu::indicator:checked:selected,
/* ::indicator:!checked won't work. use 'unchecked' */
#MainMenu QMenu::indicator:unchecked:selected,
WLibrarySidebar QMenu::item:selected,
WTrackTableViewHeader QMenu QCheckBox:selected,
WTrackTableViewHeader QMenu QCheckBox:focus,
WTrackTableViewHeader QMenu QCheckBox:hover,
WLibraryTextBrowser QMenu::item:selected,
WTrackMenu::item:selected,
WTrackMenu QMenu::item:selected,
WTrackMenu QMenu QCheckBox:selected,
WTrackMenu QMenu QCheckBox:focus,
WTrackMenu QMenu QCheckBox:hover,
QLineEdit QMenu::item:selected,
QPlainTextEdit QMenu::item:selected,
WCoverArtMenu::item:selected,
WEffectSelector::item:selected,
WEffectChainPresetSelector::item:selected,
WEffectChainPresetButton QMenu::item:selected,
WEffectChainPresetButton QMenu QCheckBox:selected,
WEffectChainPresetButton QMenu QCheckBox:focus,
WEffectChainPresetButton QMenu QCheckBox:hover,
WSearchLineEdit::item:selected,
#fadeModeCombobox::item:selected {
  background-color: #8E9099;
  color: #fff;
  /* remove OS focus indicator */
  outline: none;
  }
  /* required on Windows since the QAbstractItemViews don't inherit styles from
     the respective QComboBoxes */
  WEffectSelector QAbstractItemView,
  WEffectChainPresetSelector QAbstractItemView,
  WSearchLineEdit QAbstractItemView {
    selection-color: #fff;
    selection-background-color: #8E9099;
    border: 0px;
    outline: none;
  }

/* disabled menu items and checkboxes */
#MainMenu::item:disabled,
#MainMenu QMenu::item:disabled,
WLibrarySidebar QMenu::item:disabled,
WLibraryTextBrowser QMenu::item:disabled,
WTrackMenu::item:disabled,
WTrackMenu QMenu::item:disabled,
WTrackMenu QMenu QCheckBox:disabled,
QLineEdit QMenu::item:disabled,
QPlainTextEdit QMenu::item:disabled {
  color: #8E9099;
}

  #MainMenu QMenu::separator,
  WLibrarySidebar QMenu::separator,
  WTrackTableViewHeader QMenu::separator,
  WEffectChainPresetButton QMenu::separator,
  WTrackMenu::separator,
  WTrackMenu QMenu::separator,
  WLibraryTextBrowser QMenu::separator,
  QLineEdit QMenu::separator,
  QPlainTextEdit QMenu::separator {
    border-top: 1px solid #0a0a0a;
  }

WLibrarySidebar QMenu::indicator,
WTrackTableViewHeader QMenu QCheckBox::indicator,
WEffectChainPresetButton QMenu QCheckBox::indicator,
WTrackMenu QMenu QCheckBox::indicator {
  background-color: #111318;
  border: 1px solid #2E3136;
  border-radius: 1px;
  }
  WLibrarySidebar QMenu::indicator:checked,
  WTrackTableViewHeader QMenu QCheckBox::indicator:checked,
  WEffectChainPresetButton QMenu QCheckBox::indicator:checked,
  WTrackMenu QMenu QCheckBox::indicator:checked {
    image: url(skin:/../TrackStarM3/buttons/btn_lib_checkmark.svg);
    border: 1px solid #111;
  }
  WTrackMenu QMenu QCheckBox::indicator:indeterminate {
    image: url(skin:/../TrackStarM3/buttons/btn_lib_checkmark_indeterminate.svg);
    background-color: #191C20;
  }
  /* disabled menu checkbox */
  WTrackMenu QMenu QCheckBox::indicator:disabled {
    background-color: #222;
  }
  WTrackMenu QMenu QCheckBox::indicator:disabled:checked {
    image: url(skin:/../TrackStarM3/buttons/btn_lib_checkmark_grey.svg);
  }
  WTrackMenu QMenu QCheckBox::indicator:disabled:indeterminate {
    image: url(skin:/../TrackStarM3/buttons/btn_lib_checkmark_indeterminate_grey.svg);
  }
WSearchRelatedTracksMenu #SearchSelectedAction::indicator {
  border: 0px;
  background-color: transparent;
  image: url(skin:/../TrackStarM3/buttons/btn_search.svg);
  }
  WSearchRelatedTracksMenu #SearchSelectedAction::indicator:disabled {
    image: url(skin:/../TrackStarM3/buttons/btn_search_disabled.svg);
  }

/* widgets in cue popup menu */
#CueDeleteButton,
#CueSavedLoopButton {
  /* color buttons are 42x24 px.
  To get the final size for the Delete button consider border width.
  tall button, about the same height as cue number + label edit box */
  width: 26px;
  height: 44px;
  border: 1px solid #44474F;
  background-color: #2E3136;
  border-radius: 2px;
  }
  #CueDeleteButton {
    /* Note: we can't use qproperty-icon here because it's evauated only once
       and therefore won't style the checked state */
    image: url(skin:/../TrackStarM3/buttons/btn_delete.svg);
  }
  #CueSavedLoopButton:!checked {
    image: url(skin:/../TrackStarM3/buttons/btn_loop_beatjump_off.svg);
  }
  #CueSavedLoopButton:checked {
    border: 1px solid #44474F;
    background-color: #EBC274;
    image: url(skin:/../TrackStarM3/buttons/btn_loop_beatjump_on_black.svg);
  }
#CueLabelEdit {
  border: 1px solid #AAC7FF;
  border-radius: 0px;
  color: #C4C6D0;
  background-color: #000;
  selection-color: #000;
  selection-background-color: #C4C6D0;
  padding: 2px;
}

#AlignTop {
  qproperty-layoutAlignment: 'AlignTop';
}
#AlignLeft {
  qproperty-layoutAlignment: 'AlignLeft | AlignVCenter';
}
#AlignTopLeft {
  qproperty-layoutAlignment: 'AlignLeft | AlignTop';
}
#AlignBottomLeft {
  qproperty-layoutAlignment: 'AlignLeft | AlignBottom';
}
#AlignRight {
  qproperty-layoutAlignment: 'AlignRight | AlignVCenter';
}
#AlignRightCenter {
  qproperty-layoutAlignment: 'AlignRight | AlignVCenter';
}
#AlignVCenter {
  qproperty-layoutAlignment: 'AlignVCenter';
}
#AlignCenter {
  qproperty-layoutAlignment: 'AlignHCenter | AlignVCenter';
}
#AlignTopCenter {
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
}

#Spacer0f {
  background-color: #111318;
  }
  #RoundSpacer0f {
    background-color: #111318;
    border-radius: 2px;
  }
#Spacer1e {
  background-color: #191C20;
}
#Spacer25 {
  background-color: #282A2F;
}
#Spacer33 {
  background-color: #2E3136;
  border-radius: 0px;
}
#Spacer58 {
  background-color: #44474F;
}
#SpacerFF {
  background-color: #fff;
}
#Text33 {
  color: #2E3136;
  font-size: 1px/1px;
}
#RoundFiller25 {
  background-color: #282A2F;
  border-radius: 3px;
}

/*################################################################
 ######  Library styling is hard  ###############################
 ################### most of it was LateNight & Deere ##########
############ added styling for AutoDJ & Recording etc ##### */

#SearchBoxContainer {
  margin-bottom: 5px;
}

#LibMiniMaxiButton {
  }
  #LibMiniMaxiButton[displayValue="0"] {
    image: url(skin:/../TrackStarM3/buttons/btn_lib_maxi.svg) no-repeat center top;
    }
    #LibMiniMaxiButton[displayValue="0"]:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_lib_maxi_hover.svg) no-repeat center top;
    }
  #LibMiniMaxiButton[displayValue="1"] {
    image: url(skin:/../TrackStarM3/buttons/btn_lib_mini.svg) no-repeat center top;
    }
    #LibMiniMaxiButton[displayValue="1"]:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_lib_mini_hover.svg) no-repeat center top;
    }

WTrackTableView,
WLibraryTextBrowser,
WLibrarySidebar {
  border: 2px solid #44474F;
  /* font-weight: normal; */
  background-color: #111318;
  alternate-background-color: #191C20;
  /* In selected library rows this sets the color of
    * shapes in star rating delegate
    * focus border of Cover Art and Color delegates
     > See src/library/coverartdelegate.cpp: "option.palette.highlightedText().color();" */
  selection-color: #fff;
  /* background of Color delegate in selected row */
  selection-background-color: #8E9099;
}
WTrackTableView,
WLibraryTextBrowser,
WLibrarySidebar,
#LibraryBPMButton::item,
#LibraryPlayedCheckbox::item {
  color: #C4C6D0;
}
/* Override the 'missing' color in Tracks > Missing,
   it's not useful there */
#DlgMissing WTrackTableView {
  qproperty-trackMissingColor: #C4C6D0;
}

/* Prevent OS-style checkbox from being rendered underneath the custom style. */
#LibraryPlayedCheckbox::item,
#LibraryBPMButton::item {
  border: 0px;
}

/* selected table row */
WTrackTableView::item:selected,
#LibraryBPMButton::item:selected,
#LibraryPlayedCheckbox::item:selected {
  /* disabled since it interferes with selection-color
     which we use in DefaultDelegate and TableItemDelegate to
     blend the highlight color with the played/missing color.
   color: #fff;*/
  /* This is not required for painting the background,
     but it is for applying the focus outline. */
  background-color: #8E9099;
  }
  /* Highlight currentIndex which can be moved with Ctrl + arrow keys */
  WTrackTableView::item:!selected:focus {
    /* For outline to be applied, background-color must be set, too ...
       Use a value between #111318 and #161616 (alternate-background-color) */
    background-color: #1D2024;
    outline: 1px solid #fff;
    color: #fff;
  }
WLibrarySidebar,
WLibrarySidebar::item:focus {
  outline: none;
}

/* Use the native focus decoration */
/* This is for all cells including Played and Location */
WTrackTableView,
/* This is for the BPM cell */
WTrackTableView QCheckBox:focus {
    outline: 1px solid #fff;
}
/* This uses a custom qproperty to set the focus border
  for Color and Cover Art cells, 1px solid, sharp corners.
  See src/library/tableitemdelegate.cpp */
WTrackTableView {
  /* This uses a custom qproperty to set the focus border
     for Color and Cover Art cells, 1px solid, sharp corners.
     See src/library/tableitemdelegate.cpp */
  qproperty-focusBorderColor: #fff;
  /* This is the color used to paint the text of played tracks.
     BaseTrackTableModel::data() uses this to override Qt::ForegroundRole (QBrush). */
  qproperty-trackPlayedColor: #8E9099;
}

  /* Table cell in edit mode */
  WLibrary QLineEdit,
  WLibrary QPlainTextEdit,
  /* Track label inline editor in decks and samplers */
  WTrackPropertyEditor,
  #LibraryBPMSpinBox {
    color: #dde4ed;
    background-color: #111318;
    selection-color: #000;
    selection-background-color: #C4C6D0;
    border-width: 1px;
    border-style: solid;
  }
  WLibrary QLineEdit,
  #LibraryBPMSpinBox {
    border-color: #8E9099;
  }

WLibrarySidebar {
  min-height: 90px;
  min-width: 90px;
  border-width: 1px 1px 1px 0px;
  border-style: solid;
  border-color: #44474F;
  show-decoration-selected: 0;
  /* Don't define top margin here, it won't shift ScrollBar.
  Shift WSearchLineEdit instead */
  margin: 0px;
  }
  WTrackPropertyEditor,
  WTrackTableView:focus,
  WLibrarySidebar:focus,
  WTrackTableView:focus,
  WSearchLineEdit:focus {
  /* New Library navigation COs only work if TreeView or TableView have focus.
    Clicking on buttons, sliders and visuals elsewhere removes focus from Library.
    In conjunction with [Library],MoveFocusBackward/..Forward, some highlight
    helps a lot. */
    border-color: #AAC7FF;
  }

/*  Closed branch icon in tree */
WLibrarySidebar::branch:has-children:!has-siblings:closed,
WLibrarySidebar::branch:closed:has-children:has-siblings {
  image: url(skin:/../TrackStarM3/graphics/branch_closed.svg);
  }
  WLibrarySidebar::branch:has-children:!has-siblings:closed:selected,
  WLibrarySidebar::branch:closed:has-children:has-siblings:selected {
    background-color: #2E3136;
  }

/*  Open branch icon in tree */
WLibrarySidebar::branch:open:has-children:!has-siblings,
WLibrarySidebar::branch:open:has-children:has-siblings {
  image: url(skin:/../TrackStarM3/graphics/branch_open.svg);
  }
  WLibrarySidebar::branch:open:has-children:!has-siblings:selected,
  WLibrarySidebar::branch:open:has-children:has-siblings:selected {
    border-image: none;
    background-color: #2E3136;
  }
/* Text label of branch item */
WLibrarySidebar::item:selected {
  border-image: none;
  background-image: none;
  background-color: #2E3136;
  color: #C4C6D0;
  }
  /* space left of selected child item */
  WLibrarySidebar::branch:!has-children:!has-siblings:closed:selected,
  WLibrarySidebar::branch:closed:!has-children:has-siblings:selected,
  WLibrarySidebar::branch:open:!has-children:!has-siblings:selected,
  WLibrarySidebar::branch:open:!has-children:has-siblings:selected {
    border-image: none;
    background-color: #111318;
  }

WLibrarySidebar::item:!selected {
  border-image: none;
  background-image: none;
  background-color: #111318;
  color: #C4C6D0;
  }
WLibrarySidebar::item:selected:focus {
  outline: none;
}
WLibrarySidebar::item:!selected:focus {
  outline: none;
  border: 1px solid white;
}

WTrackTableViewHeader {
  /* Don't set a font size to pick up the system font size. */
  font-weight: normal;
  color: #C4C6D0;
  background-color: #191C20;
  }
  /*  Library header 'buttons'  */
  WTrackTableViewHeader::section {
    height: 1.1em;
    padding: 0 -0.7em 0 0.1em;
    /*  use 'border-right' so that for the header of the leftmost column
    the border doesn't add to the border of the surrounding qtableview */
    border-right: 1px solid #44474F;
    background-color: #2E3136;
    border-radius: 0px;
    }
  WTrackTableViewHeader::section:hover {
    background-color: #44474F;
    border-radius: 0px;
  }

  WTrackTableViewHeader::up-arrow,
  WTrackTableViewHeader::down-arrow {
    width: 0.6em;
    padding-right: 0.1em;
    border-right: 1px solid #44474F;
    background-color: rgba(41,48,63,200);
    }
    WTrackTableViewHeader::up-arrow:hover,
    WTrackTableViewHeader::down-arrow:hover {
      background-color: rgba(69,80,95,200);
    }
    WTrackTableViewHeader::up-arrow {
      image: url(skin:/../TrackStarM3/graphics/library_sort_up.svg);
      }
    WTrackTableViewHeader::down-arrow {
      image: url(skin:/../TrackStarM3/graphics/library_sort_down.svg);
      }

WLibraryTextBrowser {
  padding-left: 5px;
}

/* Scroll bars */
#LibraryContainer QScrollBar,
WEffectSelector QAbstractScrollArea QScrollBar,
WEffectChainPresetSelector QAbstractScrollArea QScrollBar,
WSearchLineEdit QAbstractScrollArea QScrollBar,
#fadeModeCombobox QAbstractScrollArea QScrollBar {
  padding: 1px;
}
#LibraryContainer QScrollBar:horizontal,
WEffectSelector QAbstractScrollArea QScrollBar:horizontal,
WEffectChainPresetSelector QAbstractScrollArea QScrollBar:horizontal,
WSearchLineEdit QAbstractScrollArea QScrollBar:horizontal,
#fadeModeCombobox QAbstractScrollArea QScrollBar:horizontal {
  min-width: 12px;
  height: 10px;
  background: #000;
  border-radius: 2px;
  }
  #LibraryContainer QScrollBar:vertical,
  WEffectSelector QAbstractScrollArea QScrollBar:vertical,
  WEffectChainPresetSelector QAbstractScrollArea QScrollBar:vertical,
  WSearchLineEdit QAbstractScrollArea QScrollBar:vertical,
  #fadeModeCombobox QAbstractScrollArea QScrollBar:vertical {
    min-height: 12px;
    width: 10px;
    background: #000;
    border-radius: 2px;
    }
  /* "add-page" and "sub-page" are the gutter of the scrollbar */
  #LibraryContainer QScrollBar::add-page,
  #LibraryContainer QScrollBar::sub-page,
  WEffectSelector QAbstractScrollArea QScrollBar::add-page,
  WEffectSelector QAbstractScrollArea QScrollBar::sub-page,
  WEffectChainPresetSelector QAbstractScrollArea QScrollBar::add-page,
  WEffectChainPresetSelector QAbstractScrollArea QScrollBar::sub-page,
  WSearchLineEdit QAbstractScrollArea QScrollBar::add-page,
  WSearchLineEdit QAbstractScrollArea QScrollBar::sub-page,
  #fadeModeCombobox QAbstractScrollArea QScrollBar::add-page,
  #fadeModeCombobox QAbstractScrollArea QScrollBar::sub-page {
    min-width: 15px;
    min-height: 15px;
    background-color: #000;
    }
  #LibraryContainer QScrollBar::handle:horizontal,
  WEffectSelector QAbstractScrollArea QScrollBar::handle:horizontal,
  WEffectChainPresetSelector QAbstractScrollArea QScrollBar::handle:horizontal,
  WSearchLineEdit QAbstractScrollArea QScrollBar::handle:horizontal,
  #fadeModeCombobox QAbstractScrollArea QScrollBar::handle:horizontal {
    min-width: 25px;
    background: #44474F;
    border-radius:2px;
    }
    #LibraryContainer QScrollBar::handle:horizontal:hover,
    WEffectSelector QAbstractScrollArea QScrollBar::handle:horizontal:hover,
    WEffectChainPresetSelector QAbstractScrollArea QScrollBar::handle:horizontal:hover,
    WSearchLineEdit QAbstractScrollArea QScrollBar::handle:horizontal:hover,
    #fadeModeCombobox QAbstractScrollArea QScrollBar::handle:horizontal:hover {
      background: #C4C6D0;
    }
  #LibraryContainer QScrollBar::handle:vertical,
  WEffectSelector QAbstractScrollArea QScrollBar::handle:vertical,
  WEffectChainPresetSelector QAbstractScrollArea QScrollBar::handle:vertical,
  WSearchLineEdit QAbstractScrollArea QScrollBar::handle:vertical,
  #fadeModeCombobox QAbstractScrollArea QScrollBar::handle:vertical {
    min-height: 25px;
    background: #44474F;
    border-radius:2px;
    }
    #LibraryContainer QScrollBar::handle:vertical:hover,
    WEffectSelector QAbstractScrollArea QScrollBar::handle:vertical:hover,
    WEffectChainPresetSelector QAbstractScrollArea QScrollBar::handle:vertical:hover,
    WSearchLineEdit QAbstractScrollArea QScrollBar::handle:vertical:hover,
    #fadeModeCombobox QAbstractScrollArea QScrollBar::handle:vertical:hover {
      background: #C4C6D0;
    }
  /* Turn off scroll buttons */
  #LibraryContainer QScrollBar::add-line:horizontal,
  #LibraryContainer QScrollBar::add-line:vertical,
  WEffectSelector QAbstractScrollArea QScrollBar::add-line:horizontal,
  WEffectSelector QAbstractScrollArea QScrollBar::add-line:vertical,
  WEffectChainPresetSelector QAbstractScrollArea QScrollBar::add-line:horizontal,
  WEffectChainPresetSelector QAbstractScrollArea QScrollBar::add-line:vertical,
  WSearchLineEdit QAbstractScrollArea QScrollBar::add-line:horizontal,
  WSearchLineEdit QAbstractScrollArea QScrollBar::add-line:vertical,
  #fadeModeCombobox QAbstractScrollArea QScrollBar::add-line:horizontal,
  #fadeModeCombobox QAbstractScrollArea QScrollBar::add-line:vertical {
    width: 0px;
    height: 0px;
  }
  #LibraryContainer QScrollBar::sub-line:horizontal,
  #LibraryContainer QScrollBar::sub-line:vertical,
  WEffectSelector QAbstractScrollArea QScrollBar::sub-line:horizontal,
  WEffectSelector QAbstractScrollArea QScrollBar::sub-line:vertical,
  WEffectChainPresetSelector QAbstractScrollArea QScrollBar::sub-line:horizontal,
  WEffectChainPresetSelector QAbstractScrollArea QScrollBar::sub-line:vertical,
  WSearchLineEdit QAbstractScrollArea QScrollBar::sub-line:horizontal,
  WSearchLineEdit QAbstractScrollArea QScrollBar::sub-line:vertical,
  #fadeModeCombobox QAbstractScrollArea QScrollBar::sub-line:horizontal,
  #fadeModeCombobox QAbstractScrollArea QScrollBar::sub-line:vertical {
    width: 0px;
    height: 0px;
  }
  /* Corner in between two scrollbars */
  #LibraryContainer QAbstractScrollArea::corner,
  WEffectSelector QAbstractScrollArea::corner,
  WEffectChainPresetSelector QAbstractScrollArea::corner,
  WSearchLineEdit QAbstractScrollArea::corner,
  #fadeModeCombobox QAbstractScrollArea::corner {
    background-color: #111318;
    border: 0px;
  }

/* Pushbuttons, a lot of them...
Library features and their buttons:
  Tracks DlgMissing
    QPushButton#btnSelect
    QPushButton#btnPurge
  Tracks DlgHidden
    QPushButton#btnSelect
    QPushButton#btnPurge
    QPushButton#btnUnhide
    QPushButton#
  DlgAutoDJ
    QPushButton#pushButtonShuffle
    QPushButton#pushButtonAddRandomTrack
    QPushButton#pushButtonSkipNext
    QPushButton#pushButtonFadeNow
    QSpinBox#spinBoxTransition
    QLabel#labelSelectionInfo
  DlgAnalysis
    + some small margin to maximize and cover art button
    + make radio buttons blue like active keylock button
    QRadioButton#radioButtonRecentlyAdded
    QRadioButton#radioButtonAllSongs
    QLabel#labelProgress
    QPushButton#pushButtonSelectAll
    QPushButton#pushButtonAnalyze
  DlgRecording
    QLabel#label > "Status: ..."
    QPushButton#pushButtonRecording > un/checked

    */
#LibraryFeatureControls QPushButton {
  text-align: center;
  font-weight: normal;
  /* Note(ronso0)
  Interferes with skin scaling, system font size respectively
  font-size: 14px/14px;
  Setting height/width here will prevent the buttons being scaled properly
  min-height: 22px;
  max-height: 22px;
  height: 22px; */
  color: #C4C6D0;
  border-radius: 2px;
  border: 1px solid #2E3136;
  margin: 1px 2px 4px 1px;
  padding: 3px 6px 3px 6px;
  background-color: #2E3136;
  background-position: center;
  }
  #DlgAutoDJ > #LibraryFeatureControls QPushButton {
    padding: 1px 2px;
    height: 20px;
    min-width: 32px;
  }
  #pushButtonAutoDJ {
    width: 42px;
  }

  #LibraryFeatureControls QPushButton:!enabled {
    color: #C4C6D0;
    }
  #LibraryFeatureControls QPushButton:hover,
  #fadeModeCombobox:hover {
    border: 1px solid #C4C6D0;
    }
  #LibraryFeatureControls QPushButton:unchecked {
    color: #C4C6D0;
    background-color: #44474F;
    }
  #LibraryFeatureControls QPushButton:checked {
    color: #000;
    background-color: #EBC274;
    }
  #LibraryFeatureControls QPushButton:checked:hover {
    border: 1px solid #fff;
    }
  QPushButton#pushButtonRecording:unchecked {
    color: #C4C6D0;
    background-color: #44474F;
    border: 1px solid #44474F;
  }
  QPushButton#pushButtonAutoDJ:checked {
    border: 1px solid #EBC274;
  }
  QPushButton#pushButtonRepeatPlaylist:checked {
    background-color: #C4C6D0;
    border: 1px solid #bbb;
  }
  QPushButton#pushButtonRecording:unchecked:hover,
  QPushButton#pushButtonRecording:checked {
    color: #dddddd;
    background-color: #93000A;
    border: 1px solid #ca0000;
  }

  /* make library action buttons bold */
  QPushButton#pushButtonAutoDJ,
  QPushButton#pushButtonRecording,
  QPushButton#pushButtonAnalyze,
  QPushButton#btnPurge,
  QPushButton#btnUnhide {
    font-weight: normal;
  }

  /* 'Enable AutoDJ' button */
  QPushButton#pushButtonAutoDJ:hover,
  QPushButton#pushButtonAnalyze:hover {
    border: 1px solid #AAC7FF;
  }
  /* Increased margin for action buttons */
  QPushButton#pushButtonAutoDJ,
  QPushButton#pushButtonRecording {
    margin: 1px 5px 4px 1px;
  }
  QPushButton#btnPurge {
    margin: 1px 1px 4px 5px;
  }

/* AutoDJ button icons */
QPushButton#pushButtonAutoDJ:!checked {
  image: url(skin:/../TrackStarM3/buttons/btn_autodj_enable_off.svg) no-repeat center center;
  }
  QPushButton#pushButtonAutoDJ:checked {
    image: url(skin:/../TrackStarM3/buttons/btn_autodj_enable_on.svg) no-repeat center center;
  }
QPushButton#pushButtonFadeNow:!enabled {
  image: url(skin:/../TrackStarM3/buttons/btn_autodj_fade_disabled.svg) no-repeat center center;
  }
  QPushButton#pushButtonFadeNow:enabled {
    image: url(skin:/../TrackStarM3/buttons/btn_autodj_fade.svg) no-repeat center center;
  }
QPushButton#pushButtonSkipNext:!enabled {
  image: url(skin:/../TrackStarM3/buttons/btn_autodj_skip_disabled.svg) no-repeat center center;
  }
  QPushButton#pushButtonSkipNext:enabled {
    image: url(skin:/../TrackStarM3/buttons/btn_autodj_skip.svg) no-repeat center center;
  }
QPushButton#pushButtonShuffle {
  image: url(skin:/../TrackStarM3/buttons/btn_autodj_shuffle.svg) no-repeat center center;
}
QPushButton#pushButtonAddRandomTrack {
  image: url(skin:/../TrackStarM3/buttons/btn_autodj_addrandom.svg) no-repeat center center;
}
QPushButton#pushButtonRepeatPlaylist:!checked {
  image: url(skin:/../TrackStarM3/buttons/btn_autodj_repeat_playlist_off.svg) no-repeat center center;
  }
  QPushButton#pushButtonRepeatPlaylist:checked {
    image: url(skin:/../TrackStarM3/buttons/btn_autodj_repeat_playlist_on.svg) no-repeat center center;
  }
/* AutoDJ button icons */

  /* align/center AutoDJ transition label vertically with spinbox */
  QLabel#labelTransitionAppendix {
    margin: 0px 0px 5px 0px;
  }
  /* Push labels away from buttons at the right */
  /* AutoDJ selection info */
  QLabel#labelSelectionInfo,
  /* Analysis progress info */
  QLabel#labelProgress {
    margin: 0px 4px 5px 2px;
  }

  /* Recording info */
  QLabel#labelRecFilename {
    font-weight: normal;
    margin: 0px 1px;
  }
  QLabel#labelRecPrefix,
  QLabel#labelRecStatistics {
    font-weight: normal;
  }

  /* Entire BPM cell */
  /* Lock icon at the left */
  #LibraryBPMButton::indicator:checked {
    image: url(skin:/../TrackStarM3/buttons/btn_lib_bpm_locked.svg);
    }
  #LibraryBPMButton::indicator:unchecked {
    image: url(skin:/../TrackStarM3/buttons/btn_lib_bpm_unlocked.svg);
    }

#LibraryBPMSpinBox {
  padding: 0px;
  margin: 0px;
  border-left: 0px;
  }
  #LibraryBPMSpinBox::up-button,
  #LibraryBPMSpinBox::down-button {
    background-color: #111318;
    }
    #LibraryBPMSpinBox::up-button {
      image: url(skin:/../TrackStarM3/buttons/btn_lib_spinbox_up_white.svg) no-repeat;
      }
    #LibraryBPMSpinBox::down-button {
      image: url(skin:/../TrackStarM3/buttons/btn_lib_spinbox_down_white.svg) no-repeat;
    }

  /* Button in library "Preview" column */
  #LibraryPreviewButton {
    background: transparent;
    margin: 0px;
    padding: 0px;
    border: 1px solid transparent;
    }
    #LibraryPreviewButton:!checked {
      image: url(skin:/../TrackStarM3/buttons/btn_lib_preview_play.svg);
      }
      #LibraryPreviewButton:!checked:hover {
        border: 1px solid #C4C6D0;
        background: #111318;
      }
    #LibraryPreviewButton:checked {
      image: url(skin:/../TrackStarM3/buttons/btn_lib_preview_pause.svg);
      background-color: #000;
      border: 1px solid #8E9099;
      }
      #LibraryPreviewButton:checked:hover {
        border: 1px solid #C4C6D0;
      }
    /* None of these would style the Preview button background if
      the respective table row is selected:
    #LibraryPreviewButton {
      show-decoration-selected: 0;
    }
    #LibraryPreviewButton:selected,
    #LibraryPreviewButton::item,
    #LibraryPreviewButton::item:selected,
    #LibraryPreviewButton:focus {
      background: #451212;
    }*/

  /* checkbox in library "Played" column */
  #LibraryPlayedCheckbox::indicator:checked {
    image: url(skin:/../TrackStarM3/buttons/btn_lib_checkbox_checked.svg);
    }
  #LibraryPlayedCheckbox::indicator:unchecked {
    image: url(skin:/../TrackStarM3/buttons/btn_lib_checkbox.svg);
    }

#LibraryFeatureControls QSpinBox {
  min-height: 22px;
  max-height: 22px;
  min-width: 40px;
  max-width: 40px;
}

/* library search text box */
WSearchLineEdit {
  padding: 2px;
  border: 1px solid #44474F;
  color: #C4C6D0;
  background-color: #111318;
  selection-color: #111318;
  selection-background-color: #C4C6D0;
/* margin will increase the Qt widget size which is used to position the
  Clear button. If > 0 it will shift the cue button outside the visible
  search box.
  margin-bottom: 5px; */
  }
  WSearchLineEdit:focus {
    color: #E2E2E9;
  }
  /* Clear button: see /skins/default.qss */

#LibraryFeatureControls QLabel,
#LibraryFeatureControls QRadioButton { /*
  background: none;
  Extra declaration for QRadioButton otherwise it shows up with
  wrong colors in Linux with Gnome  */
  color: #C4C6D0;
}

QRadioButton#radioButtonRecentlyAdded,
QRadioButton#radioButtonAllSongs {
  padding: 1px 3px 3px 1px;
  color: #C4C6D0;
}

QRadioButton#radioButtonRecentlyAdded {
  margin: 0px 3px 0px 5px;
}

#LibraryFeatureControls QRadioButton::indicator:checked {
  image: url(skin:/../TrackStarM3/buttons/btn_lib_radio_button_on.svg) center center;
}

#LibraryFeatureControls QRadioButton::indicator:unchecked {
  image: url(skin:/../TrackStarM3/buttons/btn_lib_radio_button_off.svg) center center;
}

/* explicitly remove icons from unchecked items otherwise
  selected, unchecked items would have a checkmark */
WLibrarySidebar QMenu::indicator:unchecked,
WLibrarySidebar QMenu::indicator:unchecked:selected,
WTrackTableViewHeader QMenu::indicator:unchecked,
WTrackTableViewHeader QMenu::indicator:unchecked:selected,
WEffectSelector::indicator:unchecked,
WEffectSelector::indicator:unchecked:selected,
WEffectChainPresetSelector::indicator::unchecked,
WEffectChainPresetSelector::indicator::unchecked:selected,
#fadeModeCombobox::indicator:unchecked,
#fadeModeCombobox::indicator:unchecked:selected {
  image: none;
}

WRateRange {
    font-size: 11px;
}

/* === Eigen aanpassingen TrackStarM3 === */
#DecksRow {
  background-color: #2E3136;
}
WTrackTableView,
WTrackTableView QHeaderView::section {
  font-size: 15px;
}
WLibrarySidebar {
  font-size: 15px;
}
#DeckZone {
  background-color: #2E3136;
}
#SourcesToggle {
  background-color: #44474F;
  color: #AAC7FF;
  border: 1px solid #AAC7FF;
  border-radius: 4px;
  font-size: 14px;
}

/* ---- Stem-controls (Mixxx 2.7 stem-tracks) ---- */
#StemRow {
  margin: 2px 0px;
}
#StemLabel {
  font-weight: bold;
  font-size: 15px;
}
WPushButton#StemMuteButton {
  background-color: #262e3d;
  color: #C4C6D0;
  border: 1px solid #8E9099;
  border-radius: 3px;
  font-weight: bold;
}
WPushButton#StemMuteButton[displayValue="1"] {
  background-color: #a83232;
  color: #ffffff;
  border: 1px solid #d05050;
}

/*################################################################
  ######  Restyle juli 2026 — strak & clean  #####################
  Koel blauwgrijs palet, subtiele gradients, deck-cards met
  ademruimte en duidelijke visuele hiërarchie.
  Deze regels overschrijven bewust regels hierboven.
##################################################################*/

/* ---- Vlakken die de venster-gradient moeten doorlaten ---- */
#SpinnyCoverContainer,
#LoopBeatJumpContainer,
#DecksRow,
#DeckRowText,
#HotCues_Sampler_Preview {
  background-color: transparent;
}

/* ---- Deck-cards: afgeronde panelen met eigen subtiele gradient ---- */
#DeckZone {
  background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
    stop: 0 #242c3a,
    stop: 1 #1b212c);
  border: 1px solid #303a4a;
  border-radius: 12px;
  margin: 8px;
  padding: 10px 8px;
}

/* Middenkolom (tracklist + crossfader) krijgt dezelfde verticale marge
   zodat de drie kolommen netjes uitlijnen */
#MiddleColumn {
  margin: 8px 2px;
  background-color: transparent;
}

/* ---- Spinny-'well': donkere inzet achter spinny + BPM ---- */
#SpinnyWell {
  background-color: #111318;
  border: 1px solid #44474F;
  border-radius: 12px;
  padding: 5px;
}
#BpmHugeSync {
  background-color: transparent;
}
WNumber#BpmHuge {
  qproperty-alignment: 'AlignHCenter | AlignVCenter';
  font-size: 26px;
  font-weight: normal;
  color: #AAC7FF;
  background-color: transparent;
}
WKey#KeyHuge {
  qproperty-alignment: 'AlignHCenter | AlignVCenter';
  font-size: 15px;
  font-weight: normal;
  color: #EBC274;
  background-color: transparent;
  border-left: 1px solid #44474F;
}

/* ---- Tekst-hiërarchie in het deck ---- */
WLabel#TrackTitle,
#Deck1 #TrackTitle, #Deck2 #TrackTitle,
#Deck3 #TrackTitle, #Deck4 #TrackTitle {
  color: #AAC7FF;
  font-size: 17px/19px;
  padding: 0px 5px 2px 5px;
}
WLabel#TrackArtist {
  color: #C4C6D0;
  font-size: 13px/13px;
  padding-top: 1px;
}
#PlayPosition {
  color: #C4C6D0;
  font-size: 13px/13px;
}

/* ---- Play/Cue pads naast de spinny ---- */
#SpinnyPlayButton,
#SpinnyCueButton {
  border-radius: 14px;
  border: 1px solid #44474F;
  font-size: 15px;
  font-weight: normal;
  color: #0A305F;
  }
  #SpinnyPlayButton[displayValue="0"],
  #SpinnyCueButton[displayValue="0"] {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
      stop: 0 #E2E2E9,
      stop: 1 #C4C6D0);
  }
  #SpinnyPlayButton[displayValue="1"] {
    background-color: #AAC7FF;
    border: 1px solid #AAC7FF;
  }
  #SpinnyCueButton[displayValue="1"] {
    background-color: #EBC274;
    border: 1px solid #EBC274;
  }
  #SpinnyPlayButton:hover,
  #SpinnyCueButton:hover {
    border: 1px solid #C4C6D0;
  }

/* ---- Hotcues: rustige tiles zolang leeg ---- */
#HotcueButton[displayValue="0"] {
  color: #9A9CA6;
  background-color: #282A2F;
  border: 1px solid #44474F;
  border-radius: 6px;
  }
  #HotcueButton[displayValue="0"]:hover {
    border: 1px solid #C4C6D0;
  }
#HotcueButton[displayValue="1"] {
  border-radius: 6px;
}

/* ---- Overview: donkere inzet met randje ---- */
#DeckOverview {
  background-color: #111318;
  border: 1px solid #44474F;
}

/* ---- Stem-controls ---- */
WPushButton#StemMuteButton {
  border-radius: 5px;
}
#StemRow {
  margin: 3px 0px;
}

/* ---- Crossfader-balk in de middenkolom ---- */
#XfaderLabelA,
#XfaderLabelB {
  color: #9A9CA6;
  font-size: 13px;
  font-weight: normal;
}

/* ---- Library: rustige randen, subtiele focus ---- */
WTrackTableView,
WLibraryTextBrowser,
WLibrarySidebar {
  border: 1px solid #44474F;
  border-radius: 8px;
  background-color: #0C0E13;
  alternate-background-color: #141a24;
  selection-color: #fff;
  selection-background-color: #44474F;
}
WTrackTableView::item:selected,
#LibraryBPMButton::item:selected,
#LibraryPlayedCheckbox::item:selected {
  background-color: #44474F;
}
WTrackPropertyEditor,
WTrackTableView:focus,
WLibrarySidebar:focus,
WSearchLineEdit:focus {
  border-color: rgba(46, 230, 94, 110);
}
WTrackTableViewHeader {
  background-color: transparent;
  color: #C4C6D0;
  }
  WTrackTableViewHeader::section {
    height: 1.3em;
    padding: 1px -0.7em 1px 0.3em;
    background-color: #282A2F;
    border-right: 1px solid #44474F;
    border-bottom: 1px solid #44474F;
    }
    WTrackTableViewHeader::section:hover {
      background-color: #44474F;
    }

/* ---- Zoekbalk ---- */
WSearchLineEdit {
  padding: 3px 4px;
  border: 1px solid #44474F;
  border-radius: 6px;
  color: #C4C6D0;
  background-color: #0C0E13;
}

/* ---- Menu/FX-knoppen boven de tracklist: ghost-stijl ---- */
#SourcesToggle {
  background-color: transparent;
  color: #C4C6D0;
  border: 1px solid #44474F;
  border-radius: 6px;
  font-size: 13px;
  }
  #SourcesToggle:hover {
    color: #E2E2E9;
    border: 1px solid #C4C6D0;
  }
  #SourcesToggle[displayValue="1"] {
    color: #AAC7FF;
    border: 1px solid rgba(46, 230, 94, 150);
  }

/* ---- Tempo-rij (decks/tempo_row.xml): [-] rate-slider [+] met rate-% ---- */
#TempoRow {
  margin: 0 2px;
}
#TempoRow #RateDown, #TempoRow #RateUp {
  background-color: #282A2F;
  border-radius: 3px;
}
WNumberRate#RateText {
  qproperty-alignment: 'AlignHCenter | AlignVCenter';
  font-size: 12px;
  color: #C4C6D0;
  background-color: #0C0E13;
  border-radius: 3px;
}

/* ---- Key-weergave fix (2026-07-18) ----
   Qt 6.9-bug (mixxx#15351): objectnaam-selectors als WKey#KeyHuge worden
   genegeerd, waardoor de key-tekst zwart-op-donker (onzichtbaar) was.
   Workaround uit de issue: kale klasse-selector. Enige WKey in deze skin
   is #KeyHuge naast de BPM. */
WKey {
  qproperty-alignment: 'AlignHCenter | AlignVCenter';
  font-size: 15px;
  color: #EBC274;
  background-color: transparent;
  border-left: 1px solid #44474F;
}


/*################################################################
 ######  TrackStar suite-laag  ##################################
 ##  Vormentaal van de suite (trackstar/ui/tokens.css + kit.css):
 ##  vlakke panelen #1D2024 met 1px rand #2E3136 en 12px radius op
 ##  een subtiele gradient, knoppen 8px radius, één accent #AAC7FF,
 ##  systeemfont, kickers gedempt. Deze laag staat bewust ONDERAAN
 ##  en overschrijft de Tango-regels hierboven. Kleuren: zie de
 ##  tabel in trackstar/ui/README.md.
##############################################################*/

/* ---- venster en font ---- */
#Mixxx {
  background-color: qlineargradient(x1: 0, y1: 0, x2: 0.35, y2: 1,
    stop: 0 #111318, stop: 0.45 #111318, stop: 1 #111318);
}
WLabel, WNumber, WNumberPos, WPushButton, WKey, WTime, WTrackProperty,
WRecordingDuration, QSpinBox, WBeatSpinBox, WOverview #PassthroughLabel,
WEffectName, WLibraryTextBrowser, WTrackTableView, WLibrarySidebar,
WSearchLineEdit, WTrackTableViewHeader::section,
#LibraryFeatureControls QPushButton, #LibraryFeatureControls QLabel,
#LibraryFeatureControls QRadioButton,
#MainMenu, #MainMenu QMenu, QToolTip, WCueMenuPopup, WCueMenuPopup QLabel,
WCueMenuPopup QLineEdit, WTrackTableViewHeader QMenu, WTrackMenu, WTrackMenu QMenu,
WCoverArtMenu, WLibrarySidebar QMenu, WEffectSelector, WEffectChainPresetSelector,
WTrackPropertyEditor, #fadeModeCombobox {
  font-family: "Google Sans Flex", ".AppleSystemUIFont", "SF Pro Text", sans-serif;
}

/* ---- panelen ---- */
#DeckZone,
#MiddleColumn {
  background-color: #1D2024;
  border: 1px solid #2E3136;
  border-radius: 12px;
}
#DeckZone { padding: 6px 4px; }
#MiddleColumn { padding: 4px; }
#Deck1, #Deck2, #Deck3, #Deck4,
#DeckColumn1, #DeckColumn2, #DeckColumn3, #DeckColumn4 {
  background-color: transparent;
}
#DeckMini1, #DeckMini2, #DeckMini3, #DeckMini4 {
  background-color: #282A2F;
  border: 1px solid #2E3136;
  border-radius: 10px;
}
#DeckMini_TitlePlayPosKeyBPM { background-color: transparent; }
#MixerbarSection, #CrossfaderContainer {
  background-color: #1D2024;
  border: 1px solid #2E3136;
  border-radius: 8px;
}
#GuiCover { background-color: rgba(11, 13, 20, 160); }

/* ---- knoppen (ghost = transparant met rand, actief = accent) ---- */
WPushButton { border-radius: 8px; }
#GuiToggleButton, #GuiToggleButton2, #RecordingButton,
#BeatgridButtonToggler, #VinylControlButton[displayValue="0"],
#VinylModeButton, #VinylCueModeButton, #PassthroughButton,
#TempoRow #RateDown, #TempoRow #RateUp {
  background-color: transparent;
  border: 1px solid #44474F;
  border-radius: 8px;
  color: #C4C6D0;
  }
  #GuiToggleButton:hover, #GuiToggleButton2:hover, #RecordingButton:hover,
  #BeatgridButtonToggler:hover, #VinylControlButton:hover, #VinylModeButton:hover,
  #TempoRow #RateDown:hover, #TempoRow #RateUp:hover {
    background-color: #1D2024;
    border: 1px solid #8E9099;
    color: #E2E2E9;
  }
  #GuiToggleButton[displayValue="1"], #GuiToggleButton[displayValue="2"] {
    background-color: #282A2F;
    border: 1px solid #8E9099;
    color: #E2E2E9;
    }
    #GuiToggleButton[displayValue="1"]:hover, #GuiToggleButton[displayValue="2"]:hover {
      border: 1px solid #9A9CA6;
    }
#SourcesToggle {
  background-color: transparent;
  border: 1px solid #44474F;
  border-radius: 8px;
  color: #C4C6D0;
  font-size: 13px;
  font-weight: bold;
  }
  #SourcesToggle:hover { color: #E2E2E9; border: 1px solid #8E9099; background-color: #282A2F; }
  #SourcesToggle[displayValue="1"] {
    background-color: #AAC7FF;
    border: 1px solid #AAC7FF;
    color: #0A305F;
  }

/* hotcue-pads: vlak, 8px, rand; gezette cues houden hun eigen kleur (uit de track) */
#SpecialCueButton[displayValue="0"], #HotcueButton[displayValue="0"],
#CueUnderlay, #PlayIndicator[value="0"] {
  background-color: #282A2F;
  border: 1px solid #44474F;
  border-radius: 8px;
  color: #C4C6D0;
  }
  #SpecialCueButton[displayValue="0"]:hover, #HotcueButton[displayValue="0"]:hover,
  #CueButton[displayValue="0"]:hover {
    border: 1px solid #8E9099;
    color: #E2E2E9;
  }
#HotcueButton[displayValue="1"], #SpecialCueButton[displayValue="1"], #CueButton[displayValue="1"] {
  border-radius: 8px;
  }

/* Play en Cue naast de spinny: idle = verhoogd vlak, actief = accent (play) / geel (cue) */
#SpinnyPlayButton, #SpinnyCueButton {
  border-radius: 10px;
  border: 1px solid #44474F;
  font-weight: bold;
  }
  #SpinnyPlayButton[displayValue="0"], #SpinnyCueButton[displayValue="0"] {
    background-color: #282A2F;
    color: #E2E2E9;
  }
  #SpinnyPlayButton[displayValue="1"] {
    background-color: #AAC7FF;
    border: 1px solid #AAC7FF;
    color: #0A305F;
  }
  #SpinnyCueButton[displayValue="1"] {
    background-color: #EBC274;
    border: 1px solid #EBC274;
    color: #0A305F;
  }
  #SpinnyPlayButton:hover, #SpinnyCueButton:hover {
    border: 1px solid #8E9099;
  }
  #SpinnyPlayButton[displayValue="1"]:hover { border: 1px solid #BFD4FF; background-color: #BFD4FF; }
  #SpinnyCueButton[displayValue="1"]:hover { border: 1px solid #F0D08A; background-color: #F0D08A; }

/* ---- teksthiërarchie in het deck (zoals de Bot-deckkaart) ---- */
WLabel#TrackTitle,
#Deck1 #TrackTitle, #Deck2 #TrackTitle, #Deck3 #TrackTitle, #Deck4 #TrackTitle {
  color: #E2E2E9;
  font-weight: bold;
}
WLabel#TrackBy, WLabel#TrackByMini, WLabel#TrackComment { color: #C4C6D0; }
WNumber#BpmHuge { font-weight: bold; }
WKey#KeyHuge { font-weight: bold; border-left: 1px solid #2E3136; }

/* ---- bibliotheek: als een .panel met .tbl en .list uit de kit ---- */
#LibraryContainer { background-color: transparent; }
WTrackTableView, WLibraryTextBrowser, WLibrarySidebar {
  border: none;
  background-color: #1D2024;
  alternate-background-color: #191C20;
  color: #E2E2E9;
  selection-color: #E2E2E9;
  selection-background-color: rgba(255, 106, 61, 64);
  }
  WLibrarySidebar { border-right: 1px solid #2E3136; }
  WLibrarySidebar::item { padding: 2px 4px; border-radius: 6px; }
  WLibrarySidebar::item:selected { background-color: rgba(255, 106, 61, 46); color: #E2E2E9; }
  WLibrarySidebar::item:hover { background-color: #282A2F; }
WTrackTableView::item:selected,
#LibraryBPMButton::item:selected,
#LibraryPlayedCheckbox::item:selected {
  background-color: rgba(255, 106, 61, 64);
  }
  WTrackTableView::item:!selected:focus {
    background-color: #282A2F;
    outline: 1px solid #AAC7FF;
    color: #E2E2E9;
  }
WTrackTableView, WTrackTableView QCheckBox:focus { outline: 1px solid #AAC7FF; }
WTrackTableView {
  qproperty-focusBorderColor: #AAC7FF;
  qproperty-trackPlayedColor: #9A9CA6;
}
WTrackTableViewHeader::section {
  background-color: #1D2024;
  color: #9A9CA6;
  font-size: 11px;
  font-weight: bold;
  border: none;
  border-bottom: 1px solid #2E3136;
  border-right: 1px solid #26292E;
  padding: 4px 6px;
}
WTrackPropertyEditor, WTrackTableView:focus, WLibrarySidebar:focus, WSearchLineEdit:focus {
  border-color: #AAC7FF;
}
WSearchLineEdit {
  background-color: #191C20;
  border: 1px solid #44474F;
  border-radius: 8px;
  color: #E2E2E9;
  padding: 2px 8px;
  selection-background-color: rgba(255, 106, 61, 90);
  }
  WSearchLineEdit:focus { border: 1px solid #AAC7FF; }
WLibrary QLineEdit, WLibrary QPlainTextEdit, WTrackPropertyEditor, #LibraryBPMSpinBox {
  color: #E2E2E9;
  background-color: #191C20;
  border: 1px solid #44474F;
  border-radius: 6px;
  selection-color: #0A305F;
  selection-background-color: #AAC7FF;
}

/* ---- waveforms: rustiger rand, log-donker ---- */
#WaveformContainer1, #WaveformContainer2, #WaveformContainer3, #WaveformContainer4 {
  border-top: 1px solid #26292E;
  border-bottom: 1px solid #0C0E13;
}

/* ---- menu's en tooltips ---- */
QToolTip {
  background-color: #1D2024;
  color: #E2E2E9;
  border: 1px solid #44474F;
  padding: 4px 6px;
}
#MainMenu QMenu, WTrackMenu, WTrackMenu QMenu, WCueMenuPopup, WCoverArtMenu,
WLibrarySidebar QMenu, WTrackTableViewHeader QMenu, WLibraryTextBrowser QMenu {
  background-color: #1D2024;
  color: #E2E2E9;
  border: 1px solid #44474F;
  }
  #MainMenu QMenu::item:selected, WTrackMenu::item:selected, WTrackMenu QMenu::item:selected,
  WLibrarySidebar QMenu::item:selected, WTrackTableViewHeader QMenu::item:selected,
  WLibraryTextBrowser QMenu::item:selected {
    background-color: #282A2F;
    color: #E2E2E9;
  }

/* ---- scrollbalken zoals in de apps: dun, transparant spoor, ronde greep ---- */
QScrollBar:vertical, QScrollBar:horizontal {
  background: transparent;
  border: none;
  margin: 0px;
}
QScrollBar:vertical { width: 10px; }
QScrollBar:horizontal { height: 10px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
  background: #44474F;
  border: 2px solid transparent;
  border-radius: 5px;
  min-height: 24px;
  min-width: 24px;
  }
  QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #8E9099; }
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; border: none; height: 0px; width: 0px; }

/* ---- effect-keuzelijsten en losse blokjes in de topbar ---- */
WEffectSelector, WEffectChainPresetSelector, #fadeModeCombobox {
  background-color: #191C20;
  color: #E2E2E9;
  border: 1px solid #44474F;
  border-radius: 8px;
  padding: 1px 6px;
  }
  WEffectSelector:hover, WEffectChainPresetSelector:hover { border: 1px solid #8E9099; }
  WEffectSelector::drop-down, WEffectChainPresetSelector::drop-down { border: none; background: transparent; }
  WEffectSelector QAbstractItemView, WEffectChainPresetSelector QAbstractItemView,
  WEffectSelector QAbstractScrollArea, WEffectChainPresetSelector QAbstractScrollArea {
    background-color: #1D2024;
    color: #E2E2E9;
    border: 1px solid #44474F;
    selection-background-color: rgba(255, 106, 61, 64);
    selection-color: #E2E2E9;
  }
#UnconfiguredHeadphoneTopbar {
  background-color: #1D2024;
  border: 1px solid #2E3136;
  border-radius: 8px;
  color: #C4C6D0;
}
/* Menu/FX-schakelaars boven de bibliotheek: als .tabs (accent-tekst), niet twee gevulde knoppen */
#SourcesToggle[displayValue="1"] {
  background-color: #282A2F;
  border: 1px solid #8E9099;
  color: #AAC7FF;
}

/* ---- beat-FX-indicator in het deck: als .pill.state (uit = vlak met rand, aan = accentrand) ---- */
#DeckFxTag { color: #9A9CA6; font-size: 11px; }
#DeckFxName { color: #E2E2E9; font-size: 12px; }
#DeckFxUnderlay, #DeckFxPill { border-radius: 8px; }
#DeckFxUnderlay[displayValue="0"] {
  background-color: #282A2F;
  border: 1px solid #44474F;
  }
  #DeckFxUnderlay[displayValue="1"] {
    background-color: rgba(255, 106, 61, 64);
    border: 1px solid #AAC7FF;
  }
#DeckFxToggle[displayValue="0"]:hover { border: 1px solid #8E9099; border-radius: 8px; }
#DeckFxToggle[displayValue="1"]:hover { border: 1px solid #BFD4FF; border-radius: 8px; }

/* bibliotheek-zijbalk: gekozen bron als actieve tab (vlak + accenttekst), niet als bruine balk */
WLibrarySidebar::item:selected { background-color: #282A2F; color: #AAC7FF; }

/* ---- Bot-status in de topbar (tekst uit de Bot via de bridge) ---- */
#TrackStarBotStatus {
  color: #C4C6D0;
  font-size: 12px;
  padding: 0px 10px;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

/* TrackStar DJ Bot in de middenkolom (WTrackStarBot): de pagina tekent zelf; alleen de melding tot hij er is */
#TrackStarBot { background-color: #1D2024; }
#TrackStarBotNote { color: #C4C6D0; font-size: 13px; padding: 24px; }

/*################################################################
  ######  TrackStar: rustige laag (UX-plan 30-09-2026)  ##########
  Eén accent (oranje = speelt / hoofdactie), rood alleen voor REC,
  de rest grijs en wit. Hotcues, cue-markers en stemnamen worden in
  de fork wit gezet ([TrackStar],mono_colors, C++) — hier de rest.
##################################################################*/

/* ---- Bovenbalk: suite-schakelaar en segmented controls, als .suite / .segmented in de kit ---- */
#SuiteNav, #SegmentedGroup {
  background-color: #191C20;
  border: 1px solid #2E3136;
  border-radius: 8px;
  padding: 1px;
}
#SuiteButton, #SegmentButton[displayValue="0"] {
  background-color: transparent;
  border: none;
  border-radius: 6px;
  color: #C4C6D0;
  font-size: 12px;
  font-weight: bold;
  }
  #SuiteButton:hover, #SegmentButton[displayValue="0"]:hover {
    background-color: #282A2F;
    color: #E2E2E9;
  }
#SuiteActive, #SegmentButton[displayValue="1"] {
  background-color: #282A2F;
  border: none;
  border-radius: 6px;
  color: #E2E2E9;
  font-size: 12px;
  font-weight: bold;
}

/* Take over: rustig zolang de Bot draait, accent zodra jij draait (dan is "Back to Bot" de actie) */
#TakeOverButton[displayValue="0"] {
  background-color: #282A2F;
  border: 1px solid #44474F;
  border-radius: 8px;
  color: #E2E2E9;
  font-size: 12px;
  font-weight: bold;
  }
  #TakeOverButton[displayValue="0"]:hover { border: 1px solid #8E9099; }
#TakeOverButton[displayValue="1"] {
  background-color: #AAC7FF;
  border: 1px solid #AAC7FF;
  border-radius: 8px;
  color: #0A305F;
  font-size: 12px;
  font-weight: bold;
  }
  #TakeOverButton[displayValue="1"]:hover { background-color: #BFD4FF; border: 1px solid #BFD4FF; }

#MenuButton {
  background-color: transparent;
  border: 1px solid #44474F;
  border-radius: 8px;
  color: #E2E2E9;
  font-size: 15px;
  }
  #MenuButton:hover { background-color: #282A2F; border: 1px solid #8E9099; }

/* ---- Decks: BPM en toonsoort wit i.p.v. oranje/geel ---- */
WNumber#BpmHuge { color: #E2E2E9; }
WKey, WKey#KeyHuge { color: #E2E2E9; }   /* kale WKey: Qt 6.9-bug, zie "Key-weergave fix" */

/* CUE actief: wit vlak (zelfde taal als een gezette hotcue), niet geel */
#SpinnyCueButton[displayValue="1"], #CueButton[displayValue="1"] {
  background-color: #E2E2E9;
  border: 1px solid #E2E2E9;
  color: #0A305F;
  }
  #SpinnyCueButton[displayValue="1"]:hover, #CueButton[displayValue="1"]:hover {
    background-color: #FFFFFF;
    border: 1px solid #FFFFFF;
  }

/* Stems: gedempt = wit vlak i.p.v. rood; naam wit (kleur komt uit C++) */
WPushButton#StemMuteButton[displayValue="1"] {
  background-color: #E2E2E9;
  border: 1px solid #E2E2E9;
  color: #0A305F;
}
#StemLabel { font-size: 14px; }


/* =====================================================================================
   TrackStarM3 — Material 3-laag (gegenereerd door mixer/make_m3_skin.py, 2.6 / 06-10-2026)
   Kleuren: zie trackstar/ui/md3.css. Blauw = speelt / de "1"; paars = volgende deck + Take over;
   rood alleen REC. Hotcues en cue-markers wit. Vormen: kaarten 28 px, knoppen pil-vormig.
   ===================================================================================== */
#Mixxx, #MainArea, QMainWindow, #GuiCover { background-color: #111318; background-image: none; }
QMainWindow { background: #111318; }

/* ---- de drie kolommen = kaarten ---- */
#DeckZone, #DeckZoneB, #MiddleColumn {
  background-color: #1D2024;
  border: 2px solid #1D2024;
  border-radius: 28px;
}
#DeckZone, #DeckZoneB { padding: 12px 0px 0px 0px; margin: 8px; }
#DeckColumn1, #DeckColumn2, #DeckColumn3, #DeckColumn4 { margin: 0px 10px; }
#VuMeterClippingBorder { margin: 0px 14px 6px 14px; }
#MiddleColumn { padding: 0px; margin: 8px 2px; background-color: transparent; border-color: transparent; }
/* spelend deck: blauwe rand (WidgetGroup highlight ← [ChannelN],play_latched, zie skin.xml) */
#DeckZone[highlight="1"] { border-color: #AAC7FF; }
#DeckZoneB[highlight="1"] { border-color: #DDBCE0; }
#SpinnyWell, #SpinnyCover { background-color: transparent; border: 0px; padding: 0px; }
#DeckOverview { background-color: #1D2024; border: 0px; }
#TrackStarBotPanel, #TrackStarBot { background-color: #111318; border: 0px; }

/* ---- tekst in het deck: titel bovenaan ---- */
WLabel#TrackTitle, #Deck1 #TrackTitle, #Deck2 #TrackTitle, #Deck3 #TrackTitle, #Deck4 #TrackTitle {
  color: #E2E2E9; font-size: 16px/18px; font-weight: 500; padding: 0px 4px; qproperty-alignment: 'AlignHCenter | AlignVCenter';
}
WLabel#TrackArtist, #TrackBy, #PlayPosition, #TrackDot { color: #C4C6D0; font-size: 13px/15px; }
#TrackDot { qproperty-alignment: 'AlignCenter'; }
#TrackBy { padding-left: 0px; }

/* ---- Play / CUE: 64 px, hoek 22 ---- */
#SpinnyPlayButton, #SpinnyCueButton {
  border-radius: 21px; border: 1px solid #8E9099; font-size: 13px; font-weight: 600; color: #E2E2E9; background-color: transparent;
}
#SpinnyPlayButton[displayValue="0"] { background-color: #33353A; border-color: #33353A; }
#SpinnyPlayButton[displayValue="1"] { background-color: #AAC7FF; border-color: #AAC7FF; }
#SpinnyCueButton[displayValue="0"] { background-color: transparent; }
#SpinnyCueButton[displayValue="1"] { background-color: #3E4759; border-color: #3E4759; color: #DAE2F9; }
#SpinnyPlayButton:hover, #SpinnyCueButton:hover { border-color: #C4C6D0; }

/* ---- BPM / key / filter ---- */
WNumber#BpmHuge { font-size: 22px; font-weight: 500; color: #AAC7FF; qproperty-alignment: 'AlignHCenter | AlignTop'; }
#Deck2 WNumber#BpmHuge, #DeckColumn2 WNumber#BpmHuge, #DeckColumn4 WNumber#BpmHuge { color: #DDBCE0; }
WKey { font-size: 13px; font-weight: 400; color: #C4C6D0; border: 0px; background-color: transparent; qproperty-alignment: 'AlignLeft | AlignVCenter'; }
#FilterKnobBox { background-color: transparent; }
#FilterLabel { color: #C4C6D0; font-size: 10px; font-weight: 600; letter-spacing: 1px; qproperty-alignment: 'AlignHCenter'; }

/* ---- hotcues: 8 pads, wit als gezet ---- */
#HotcueButton[displayValue="0"] { color: #9A9CA6; background-color: #33353A; border: 0px; border-radius: 10px; }
#HotcueButton[displayValue="0"]:hover { background-color: #44474F; }
#HotcueButton[displayValue="1"] { color: #111318; background-color: #FFFFFF; border: 0px; border-radius: 10px; }
#HotcueButton[displayValue="1"]:hover { background-color: #E2E2E9; }

/* ---- stems: chips (naam = knop, klik = mute) ---- */
#StemChip { background-color: #3E4759; border-radius: 10px; }
#StemChip[highlight="1"] { background-color: transparent; border: 1px solid #44474F; }
#StemChipLabel { background-color: transparent; color: #DAE2F9; font-size: 12px; font-weight: 500; qproperty-alignment: 'AlignCenter'; }
#StemChip[highlight="1"] #StemChipLabel { color: #9A9CA6; }
/* volume door de Autopilot (deels) weggedraaid → gedimde chip; de mute-rand blijft daar los van */
#StemChipInner { background-color: transparent; }
#StemChipInner[highlight="0"] { background-color: rgba(17, 19, 24, 0.55); border-radius: 10px; }
#StemChipInner[highlight="0"] #StemChipLabel { color: #6F7380; }
#StemChipClick { background-color: transparent; border: 0px; }
#StemControls { margin: 0px; }
WPushButton#StemMuteButton { border-radius: 8px; font-size: 12px; font-weight: 500; }
WPushButton#StemMuteButton[displayValue="0"] { background-color: #3E4759; color: #DAE2F9; border: 0px; }
WPushButton#StemMuteButton[displayValue="1"] { background-color: transparent; color: #C4C6D0; border: 1px solid #44474F; }

/* ---- tempofader (verticaal) en VU ---- */
#TempoColumn { background-color: transparent; }
#RateText { color: #C4C6D0; font-size: 10px; qproperty-alignment: 'AlignCenter'; }
#VuMeterClippingBorder { border: 0px; }

/* ---- FX-knoppen naast de crossfader ---- */
#FxKnobBox { background-color: transparent; }
#FxNamePill { background-color: transparent; border: 1px solid #44474F; border-radius: 9px; }
#FxNamePill[highlight="1"] { background-color: #3E4759; border-color: #3E4759; }
#FxKnobName { color: #9A9CA6; font-size: 10px; font-weight: 600; qproperty-alignment: 'AlignCenter'; background-color: transparent; }
#FxNamePill[highlight="1"] #FxKnobName { color: #DAE2F9; }
#FxKnobToggle { background-color: transparent; border: 0px; }
#FxKicker { color: #9A9CA6; font-size: 10px; font-weight: 600; letter-spacing: 1px; qproperty-alignment: 'AlignHCenter | AlignTop'; }
WSpinny, #SpinnyCover, #SpinnyWell, #SpinnyCoverContainer { background-color: transparent; border: 0px; }

/* ---- crossfader in de middenkolom ---- */
#DeckCrossfaderBar { background-color: #1D2024; border-radius: 20px; margin: 10px 0px 0px 0px; padding: 6px 16px; qproperty-layoutAlignment: 'AlignHCenter | AlignVCenter'; }
#XfaderLabelA, #XfaderLabelB { font-size: 13px; font-weight: 600; border-radius: 14px; min-width: 28px; min-height: 28px; }
#XfaderLabelA { background-color: #284777; color: #D6E3FF; }
#XfaderLabelB { background-color: #573E5C; color: #FAD8FD; }

/* ---- A/B naast de waveforms ---- */
#WaveDeckLabels { background-color: transparent; margin: 0px 3px; }
#WaveLabelA, #WaveLabelB { font-size: 13px; font-weight: 600; border-radius: 14px; qproperty-alignment: 'AlignCenter'; }
#WaveLabelA { background-color: #284777; color: #D6E3FF; }
#WaveLabelB { background-color: #573E5C; color: #FAD8FD; }
#WaveformContainer { background-color: #111318; }

/* ---- topbar ---- */
#Topbar, #MixerBar, #SkinControlsBar { background-color: #111318; border: 0px; }
#MixerbarSection, #CrossfaderContainer { background-color: transparent; border: 0px; }
#SuiteNav { background-color: transparent; border: 0px; }
#SegmentedGroup { background-color: transparent; border: 1px solid #8E9099; border-radius: 17px; padding: 0px; }
#SegmentButton { font-size: 14px; min-height: 32px; max-height: 32px; border-radius: 16px; padding: 0px 6px; margin: 0px; }
#SuiteButton { color: #C4C6D0; font-size: 14px; font-weight: 500; border-radius: 13px; }
#SuiteButton:hover { background-color: #282A2F; color: #E2E2E9; }
#MenuButton { font-size: 18px; color: #C4C6D0; border: 0px; background-color: transparent; border-radius: 11px; }
#SuiteButton, #SegmentButton { background-color: transparent; color: #E2E2E9; border: 0px; border-radius: 12px; font-size: 12px; font-weight: 500; }
#SuiteButton:hover, #SegmentButton:hover { background-color: #282A2F; }
#SuiteActive, #SegmentButton[displayValue="1"], #SegmentButton[value="1"] { background-color: #3E4759; color: #DAE2F9; border-radius: 16px; }
#TrackStarBotStatus { color: #AAC7FF; background-color: transparent; padding: 0px 8px; font-size: 12px; font-weight: 500; }
#TakeOverButton { background-color: #573E5C; color: #FAD8FD; border: 0px; border-radius: 12px; font-weight: 500; }
#TakeOverButton[displayValue="1"] { background-color: #AAC7FF; color: #0A305F; }
#RecBox { background-color: transparent; border-radius: 8px; }
#RecButton[displayValue="1"], #RecDuration[displayValue="1"] { background-color: #93000A; color: #FFDAD6; }
#ClockBox, #ClockBox WTime { color: #C4C6D0; font-size: 13px; }

/* ---- bibliotheek ---- */
WTrackTableView, WLibraryTextBrowser, WLibrarySidebar { border: 0px; border-radius: 16px; background-color: #191C20; }
WTrackTableView::item:selected, WLibrarySidebar::item:selected { background-color: #3E4759; color: #DAE2F9; }
WSearchLineEdit { border: 0px; border-radius: 20px; background-color: #282A2F; padding: 4px 12px; }
WTrackTableViewHeader::section { background-color: #191C20; color: #C4C6D0; border: 0px; }
#LibraryFeatureControls QPushButton { border-radius: 14px; }
