/* Tango style sheet */

#Mixxx {  /*
  AlignRight just for testing, to attach SkinSettings to right edge.
  Not working. See https://github.com/mixxxdj/mixxx/issues/8646 */
  qproperty-layoutAlignment: 'AlignRight | AlignVCenter';
  /* Subtiele verticale gradient als venster-achtergrond */
  background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
    stop: 0 #1a202b,
    stop: 1 #0e1218);
  font-size: 12px/12px;
}

#SkinContainer {  /*
  AlignRight just for testing, to attach SkinSettings to right edge.
  Not working. See https://github.com/mixxxdj/mixxx/issues/8646 */
  qproperty-layoutAlignment: 'AlignRight | AlignTop';
  background-color: transparent;
}

WLabel,
WNumber, WNumberPos,
WPushButton,
WKey,
WTime,
WTrackProperty,
WRecordingDuration,
QSpinBox,
WBeatSpinBox,
WOverview #PassthroughLabel,
WEffectName,
WLibraryTextBrowser,
#LibraryFeatureControls QPushButton,
#LibraryFeatureControls QLabel,
#LibraryFeatureControls QRadioButton {
  font-family: "Google Sans Flex", ".AppleSystemUIFont", "SF Pro Text", sans-serif;
  font-weight: normal;
  font-style: normal;
}
/* Unfortunately, the proportional line height of the Ubuntu font
  is not as tall as Open Sans. For single-line buttons this doesn't
  matter but the context menus would look crammed.
  This: use Open Sans for all menus and related widgets. */
#MainMenu,
#MainMenu QMenu,
QToolTip,
WCueMenuPopup,
WCueMenuPopup QLabel,
WCueMenuPopup QLineEdit,
WTrackTableViewHeader QMenu,
WTrackTableViewHeader QMenu QCheckBox,
WTrackMenu,
WTrackMenu QMenu,
WTrackMenu QMenu QCheckBox,
QLineEdit QMenu,
QPlainTextEdit QMenu,
WCoverArtMenu,
WLibrarySidebar QMenu,
WLibraryTextBrowser QMenu,
WOverview, /* Hotcue labels in the overview */
WEffectSelector,
WEffectSelector QAbstractScrollArea,
WEffectChainPresetSelector,
WEffectChainPresetSelector QAbstractScrollArea,
WEffectChainPresetButton QMenu,
WEffectChainPresetButton QMenu QCheckBox,
WSearchLineEdit QAbstractScrollArea,
/* Track label inline editor in decks and samplers */
WTrackPropertyEditor,
#fadeModeCombobox,
#fadeModeCombobox QAbstractScrollArea,
/* With 'Ubuntu' font the header section titles would always be top-aligned... */
WTrackTableViewHeader::section {
  font-family: "Google Sans Flex", ".AppleSystemUIFont", "SF Pro Text", sans-serif;
  font-weight: normal;
  font-style: normal;
}

WPushButton {
  font-weight: normal;
  border-radius: 5px;
}

WPushButton,
#LibraryFeatureControls QPushButton,
#LibraryFeatureControls QLabel,
#LibraryFeatureControls QRadioButton {
  font-size: 12px/12px;
}

WWidgetGroup {
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
  border-radius: 1px;
}

#Library_Singleton,
#LibraryContainer,
#DeckContainer {
  background-color: transparent;
}

#GuiCover {
  qproperty-layoutAlignment: 'AlignVCenter | AlignHCenter';
  /* background is #2E3136, so this has to blend in */
  background-color: rgba(41, 48, 63, 120);
  }
  #UnconfiguredHeadphoneHint {
    font-size: 14px/14px;
    text-align: center;
    color: #fff;
  }
  #UnconfiguredHeadphoneTopbar,
  #UnconfiguredHeadphonePrevDeck {
    font-size: 12px/12px;
    color: #C4C6D0;
    }
    #UnconfiguredHeadphoneTopbar {
      background-color: #2E3136;
      padding-left: 5px;
    }
    #UnconfiguredHeadphonePrevDeck {
      background-color: rgba(41, 48, 63, 200);
      margin-left: 25px;
      padding: 1px 0px;
    }


/* splitters between
    - waveforms & lower skin part
    - treeview & library table */
#LibrarySplitter::handle:horizontal {
  image: url(skin:/../TrackStarM3/graphics/splitterHori_handle.svg);
  }
  #LibrarySplitter::handle:horizontal:hover,
  #LibrarySplitter::handle:horizontal:pressed {
    image: url(skin:/../TrackStarM3/graphics/splitterHori_handle_pressed.svg);
  }
  /* splitter between coverArt and tree view */
  #LibrarySplitter::handle:vertical,
  #WaveformSplitter::handle:vertical {
    image: url(skin:/../TrackStarM3/graphics/splitterVert_handle.svg);
    }
    #LibrarySplitter::handle:vertical:hover,
    #LibrarySplitter::handle:vertical:pressed,
    #WaveformSplitter::handle:vertical:hover,
    #WaveformSplitter::handle:vertical:pressed {
      image: url(skin:/../TrackStarM3/graphics/splitterVert_handle_pressed.svg);
    }



/*################################################################
 #######  Skin Settings  ########################################
##############################################################*/

#SkinSettingsHeader {
  qproperty-layoutAlignment: 'AlignLeft | AlignTop';
  margin: 0px;
  padding: 0px;
  }
  #SkinSettingsClose {
    border-radius:2px;
    background-color: transparent;
    image: url(skin:/../TrackStarM3/buttons/btn_skinsettings_close.svg) no-repeat center top;
    }
    #SkinSettingsClose:hover {
      border-radius:2px;
      background-color: #111318;
      image: url(skin:/../TrackStarM3/buttons/btn_skinsettings_close_hover.svg) no-repeat center top;
    }

#SkinSettingsSeparator {
}

#CategoryLabel,
#SkinSettingsCategoryButton {
  font-size: 16px/20px;
  text-align: left;
  color: #E2E2E9;
  background-color: none;
}
#CategoryLabel {
  padding: 2px 0px 0px 15px;
  border-top: 1px solid #000;
}
#SkinSettingsCategoryButton {
  padding: 2px 0px 0px 0px;
}
#SkinSettingsHeader > #CategoryLabel,
#SkinSettingsCategoryButton {
  border: 0px;
  border-radius: 0px;
}
#SkinSettingsSubMenu {
  padding-left: 10px;
}

#SkinSettingsButton,
#SkinSettingsButtonMulti  {
  font-size: 12px/12px;
  }
  #SkinSettingsButton {
    border-radius: 0px;
  }
  #DeckButtonVisibility[displayValue="0"] {
    color: #C4C6D0;
    }
    #DeckButtonVisibility[displayValue="0"]:hover,
    #DeckButtonVisibility[displayValue="1"]:hover {
    background-color: #000;
    border: 1px solid #44474F;
    }
  #SkinSettingsButtonMulti {
    text-align: center;
    border-radius: 1px;
    }
    #SkinSettingsButtonMulti[displayValue="0"] {
      border: 1px solid #000;
      }
      #SkinSettingsButtonMulti[displayValue="0"]:hover {
        border: 1px solid #44474F;
      }
    #SkinSettingsButtonMulti[displayValue="1"] {
      background-color: #000;
      color: #fff;
      font-weight: normal;
      border: 1px solid #111318;
    }

#DeckIndicatorSettings {
  margin-left: 17px;
}
#DeckButtonVisibility {
  margin-right: 1px;
  font-weight: normal;
  border-radius: 1px;
  }

#SubmenuCover,
#CoverSpinnyHint {
  background-color: rgba(26,33,44,135);
}
#SkinSettingsLabel,
#SubmenuHint {
  font-size: 12px/12px;
  }
  #SkinSettingsLabel {
    padding-bottom: 2px;
  }
  #SubmenuHint {
    color: #9A9CA6;
    margin-bottom: 2px;
  }
#CoverSpinnyHint {
  font-size: 14px;
  font-weight: normal;
  color: #AAC7FF;
  margin: 2px 0px;
}



/*################################################################
 ######## Mixer Bar #############################################
##############################################################*/
#Topbar {
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
  margin: 0px 0px 3px 0px;
}

#MixerBar {
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
  margin: 0px;
  padding: 0px;
  qproperty-layoutSpacing: 0px;
  border: 0px;
}

#MixerbarSection,
#CrossfaderContainer {
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
  qproperty-layoutSpacing: 0px;
  border-radius: 2px;
  border-top-right-radius: 0px;
  border-top-left-radius: 0px;
  background-color: #2E3136;
  }
  #MixerbarSection {
    margin: 0px;
  }
  #CrossfaderContainer {
    margin: 0px 8px;
  }

/* Eigen crossfader-balk onder de tracklist (DeckCrossfaderBar) */
#DeckCrossfaderBar {
  qproperty-layoutAlignment: 'AlignHCenter | AlignVCenter';
  qproperty-layoutSpacing: 6px;
  background-color: transparent;
  margin: 4px 0px 6px 0px;
  }
  #XfaderLabelA,
  #XfaderLabelB {
    color: #C4C6D0;
    font-size: 15px;
    font-weight: bold;
    qproperty-alignment: 'AlignCenter';
  }

#MainHeadMixerLabel {
  image: url(skin:/../TrackStarM3/buttons/btn_main_head_mixer.svg) no-repeat center center;
  }
  #MainMixerLabel {
    image: url(skin:/../TrackStarM3/buttons/btn_main.svg) no-repeat center center;
  }
  #HeadphoneMixerLabel {
    image: url(skin:/../TrackStarM3/buttons/btn_head.svg) no-repeat center center;
  }
#BoothMixerLabel {
  image: url(skin:/../TrackStarM3/buttons/btn_booth.svg) no-repeat center center;
}
#MixerbarKnob {
  qproperty-layoutAlignment: 'AlignCenter';
  margin-top: 0px;
}
#MixerbarSlider {
  margin: 0px;
}
#MixerbarCover {
  /* Note(ronso0): background is #2E3136, so this has to blend in */
  background-color: rgba(20, 25, 32, 200);
}
#MixerbarSection #GuiToggleButton[value="0"] {
  border: 1px solid #111318;
  }
  #MixerbarSection #GuiToggleButton[value="0"]:hover {
    border: 1px solid #C4C6D0;
  }
/*################################################################
 ######  Skin Controls / Rec / Broadcast / Clock ################
##############################################################*/
#SkinControlsBar {
  qproperty-layoutAlignment: 'AlignLeft | AlignVCenter';
}

#GuiToggleButton,
#GuiToggleButton2,
#RecordingButton {
  color: #C4C6D0;
  text-align: center;
  font-weight: normal;
  border: 1px solid #44474F;
  background-color: #2E3136;
  }
  #GuiToggleButton:hover,
  #GuiToggleButton2:hover {
    border: 1px solid #C4C6D0;
  }

#GuiToggleButton[displayValue="1"],
#GuiToggleButton[displayValue="2"] {
  color: #E2E2E9;
  border: 1px solid #C4C6D0;
  background-color: #282A2F;
  }
  #GuiToggleButton[displayValue="1"]:hover,
  #GuiToggleButton[displayValue="2"]:hover,
  #GuiToggleButton2:hover {
    border: 1px solid #C4C6D0;
  }

#RecBox {
/* used as Rec container as well as "Rec" label to cover RecDuration
  when inactive (--:--) */
  qproperty-layoutAlignment: 'AlignLeft | AlignTop';
  border-radius: 3px;
  background-color: #2E3136;
  }
  #RecButton[displayValue="0"] {  /*
    background-color: rgba(41, 48, 63, 120);  */
    }
    #RecButton[displayValue="0"]:hover,
    #RecButton[displayValue="2"],
    #RecButton[displayValue="1"],
    #RecButton[displayValue="2"]:hover {
      border: 1px solid #AAC7FF;
    }
    #RecButton[displayValue="2"] {
      border: 1px solid #C4C6D0;
    }
  #RecDot {
    background-color: transparent;  /*
    image: url(skin:/../TrackStarM3/graphics/rec_dot.svg) no-repeat center center; */
    font-size: 12px/12px;
    margin: 2px 0px 0px 0px;
    }
    #RecDot[value="0"] {
      color: #C4C6D0;
    }
    #RecDot[value="1"] {
      color: #AAC7FF;
    }
    #RecDot[value="2"] {
      color: #FFB4AB;
    }
  #RecDuration {
    font-weight: normal;
    color: #C4C6D0;
  }

#ClockBox {
  qproperty-layoutAlignment: 'AlignVCenter | AlignHCenter';
  padding: 2px 0px;
  qproperty-layoutSpacing: 2;
  }
  #ClockBox WLabel,
  #Clock, WTime {
    font-size: 15px/15px;
    color: #C4C6D0;
    text-align: center;
  }

#BroadcastButton,
#SkinSettingsToggler {
  background-color: transparent;
  padding: 0px;
  margin: 0px;
  }
  #BroadcastButton[displayValue="0"] {
    image: url(skin:/../TrackStarM3/buttons/btn_broadcast_off.svg) no-repeat center center;
    }
    #BroadcastButton[displayValue="0"]:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_broadcast_off_hover.svg) no-repeat center center;
      }
  #BroadcastButton[displayValue="1"] {
    image: url(skin:/../TrackStarM3/buttons/btn_broadcast_connecting.svg) no-repeat center center;
    }
  #BroadcastButton[displayValue="2"] {
    image: url(skin:/../TrackStarM3/buttons/btn_broadcast_connected.svg) no-repeat center center;
    }
  #BroadcastButton[displayValue="3"] {
    image: url(skin:/../TrackStarM3/buttons/btn_broadcast_failure.svg) no-repeat center center;
    }
  #BroadcastButton[displayValue="4"] {
    image: url(skin:/../TrackStarM3/buttons/btn_broadcast_warning.svg) no-repeat center center;
    }
    #BroadcastButton:hover {
      background-color: #111318;
    }

#SkinSettingsToggler[displayValue="0"] {
  background-color: transparent;
  image: url(skin:/../TrackStarM3/buttons/btn_skinsettings_off.svg) no-repeat center center;
  }
  #SkinSettingsToggler[displayValue="0"]:hover {
    image: url(skin:/../TrackStarM3/buttons/btn_skinsettings_on.svg) no-repeat center center;
  }



/*################################################################
 ####### Waveforms ##############################################
##############################################################*/

/* Also, see color definitions above. */
#WaveformContainer1,
#WaveformContainer2,
#WaveformContainer3,
#WaveformContainer4 {
  qproperty-layoutAlignment: 'AlignVCenter';
/* waveform play position should stay centered, so we shift the waveform
  containers right to compensate for (inactive) beatgrid button toggle
  margin-right: -17px; */
}

#BeatgridButtons,
#BeatgridButtons WWidgetGroup {
/* Those buttons are pushed outside the screen by 17px (see above),
  so bring them back in
  padding-right: 17px; */
  qproperty-layoutSpacing: 1;
}
#WaveformContainer1,
#WaveformContainer2,
#WaveformContainer3,
#WaveformContainer4 {
/* Note(ronso0):
  this will shift waveforms' center position to the left.
  Useful to 'look ahead' further (who cares about history, ha?)
  margin-left: -350px;  */
  /* Subtiele 3D-gelaagdheid: lichte bovenrand + donkere onderrand geven
     elke (stem)waveform een verhoogd, gestapeld uiterlijk. */
  border-top: 1px solid #44474F;
  border-bottom: 1px solid #0a0d12;
}

#BeatgridButtonToggler {
  background-color: #2E3136;
  }
  #BeatgridButtonToggler[displayValue="0"] {
    image: url(skin:/../TrackStarM3/buttons/btn_arrow_left.svg) no-repeat center center;
  }
  #BeatgridButtonToggler[displayValue="0"]:hover {
    image: url(skin:/../TrackStarM3/buttons/btn_arrow_left_hover.svg) no-repeat center center;
  }
#BeatgridButtonToggler[displayValue="1"] {
  image: url(skin:/../TrackStarM3/buttons/btn_arrow_right.svg) no-repeat center center;
}
  #BeatgridButtonToggler[displayValue="1"]:hover {
    image: url(skin:/../TrackStarM3/buttons/btn_arrow_right_hover.svg) no-repeat center center;
  }

#BeatgridButtons WPushButton {
  background-color: #2E3136;
  }
  #BeatgridButtons WPushButton:hover {
    background-color: #111318;
  }
  #BeatgridCurpos {
    image: url(skin:/../TrackStarM3/buttons/btn_beats_curpos.svg) no-repeat center center;
  }
  #BpmLock[value="0"] {
    image: url(skin:/../TrackStarM3/buttons/btn_bpm_unlocked.svg) no-repeat center center;
    }
    #BpmLock[value="1"] {
      image: url(skin:/../TrackStarM3/buttons/btn_bpm_locked.svg) no-repeat center center;
    }
  #Undo[value="0"] {
    image: url(skin:/../TrackStarM3/buttons/btn_undo.svg) no-repeat center center;
    }

  #BeatgridSlower {
    image: url(skin:/../TrackStarM3/buttons/btn_beats_slower.svg) no-repeat center center;
  }
  #BeatgridFaster {
    image: url(skin:/../TrackStarM3/buttons/btn_beats_faster.svg) no-repeat center center;
  }
  #BeatgridEarlier {
    image: url(skin:/../TrackStarM3/buttons/btn_beats_earlier.svg) no-repeat center center;
  }
  #BeatgridLater {
    image: url(skin:/../TrackStarM3/buttons/btn_beats_later.svg) no-repeat center center;
  }
  #HotcuesEarlier {
    image: url(skin:/../TrackStarM3/buttons/btn_hotcues_earlier.svg) no-repeat center center;
  }
  #HotcuesLater {
    image: url(skin:/../TrackStarM3/buttons/btn_hotcues_later.svg) no-repeat center center;
  }
  #BeatEditCover {
    background-color: rgba(41, 48, 63, 120);
  }

/*################################################################
 ######  Mic & Aux  #############################################
##############################################################*/
#MicAuxContainer {
  margin-bottom: 5px;
}

#MicSection {
  qproperty-layoutAlignment: 'AlignRight | AlignTop';
}
#AuxSection {
  qproperty-layoutAlignment: 'AlignLeft | AlignTop';
  }
  #MicSectionIcon {
    image: url(skin:/../TrackStarM3/buttons/btn_mic_section.svg) no-repeat center center;
  }
  #AuxSectionLabel {
    image: url(skin:/../TrackStarM3/buttons/btn_aux_section.svg) no-repeat center center;
  }

#MicUnit, #AuxUnit {
  qproperty-layoutAlignment: 'AlignLeft | AlignVCenter';
  background-color: #2E3136;
  margin-right: 5px;
  padding-left: 2px;
  }
  #MicUnitIcon {
    image: url(skin:/../TrackStarM3/buttons/btn_mic_unit.svg) no-repeat center left;
  }
  #AuxUnitIcon {
    image: url(skin:/../TrackStarM3/buttons/btn_aux_unit.svg) no-repeat center left;
  }
  #MicUnitLabel, #AuxUnitLabel {
    padding-bottom: 8px;
    color: #C4C6D0;
    font-size: 16px/22px;
    font-weight: normal;
    text-align: right;
  }

#MicAuxKnob {
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
  margin-top: 1px;
}

#MicDuckingButton {
  background-color: #9A9CA6;
  color: #111318;
  font-weight: normal;
  }
#MicDuckingButton[displayValue="0"] {
  border: 1px solid #111318;
  }
  #MicDuckingButton[displayValue="0"]:hover {
    border: 1px solid #C4C6D0;
  }
#MicDuckingButton[displayValue="1"],
#MicDuckingButton[displayValue="2"] {
  color: #E2E2E9;
  border: 1px solid #C4C6D0;
  }
  #MicDuckingButton[displayValue="1"]:hover,
  #MicDuckingButton[displayValue="2"]:hover {
    border: 1px solid #fff;
  }

#AuxXfaderButton:hover {
  background-color: #111318;
}

/*################################################################
 ######  Decks  #################################################
##############################################################*/

#DeckContainer {
  qproperty-layoutAlignment: 'AlignTop';
}

#Deck1,
#Deck3,
#Deck2,
#Deck4
#DeckMini1,
#DeckMini2,
#DeckMini3,
#DeckMini4 {
  background-color: #191C20;
}

#DeckContainer {
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
  padding-bottom: 5px;
}

#DeckMini1,
#DeckMini3 {
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
  margin: 0px 4px 5px 0px;
  border-top-right-radius: 2px;
  border-bottom-right-radius: 2px;
}

#DeckMini2,
#DeckMini4 {
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
  margin: 0px 0px 5px 4px;
  border-top-left-radius: 2px;
  border-bottom-left-radius: 2px;
}

WLabel#TrackBy,
WLabel#TrackByMini,
WLabel#TrackComment {
  color: #C4C6D0;}
#DeckContainer WLabel,
#DeckContainerMini WLabel {
  color: #C4C6D0;}

#DeckMini_TitlePlayPosKeyBPM {
  qproperty-layoutAlignment: 'AlignRight | AlignTop';
  background-color: #2E3136;
  margin: 0px 1px 0px 1px;
}

#DeckOverview {
  background-color: #111318;
  }
  #VinylTogglerLeft[displayValue="0"],
  #VinylTogglerRightPassthrough[displayValue="1"],
  #VinylTogglerRight[displayValue="1"] {
    background-color: transparent;
    image: url(skin:/../TrackStarM3/buttons/btn_vinyl_left.svg) no-repeat top center;
    }
    #VinylTogglerLeft[displayValue="0"]:hover,
    #VinylTogglerRightPassthrough[displayValue="1"]:hover,
    #VinylTogglerRight[displayValue="1"]:hover {
      background-color: transparent;
      image: url(skin:/../TrackStarM3/buttons/btn_vinyl_left_hover.svg) no-repeat top center;
    }
  #VinylTogglerLeft[displayValue="1"],
  #VinylTogglerLeftPassthrough[displayValue="1"],
  #VinylTogglerRight[displayValue="0"] {
    background-color: transparent;
    image: url(skin:/../TrackStarM3/buttons/btn_vinyl_right.svg) no-repeat top center;
    }
    #VinylTogglerLeft[displayValue="1"]:hover,
    #VinylTogglerLeftPassthrough[displayValue="1"]:hover,
    #VinylTogglerRight[displayValue="0"]:hover {
      background-color: transparent;
      image: url(skin:/../TrackStarM3/buttons/btn_vinyl_right_hover.svg) no-repeat top center;
    }
  /* When passthrough is active but Vinyl Controls are hidden,
    yellow background indicates passthrough, similar to how
    the FX expand toggle does */
  #VinylTogglerLeftPassthrough[displayValue="0"] {
    background: #00ffff;
    image: url(skin:/../TrackStarM3/buttons/btn_vinyl_pass_left.svg) no-repeat top center;
    }
    #VinylTogglerLeftPassthrough[displayValue="0"]:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_vinyl_pass_left_hover.svg) no-repeat top center;
    }
  #VinylTogglerRightPassthrough[displayValue="0"] {
    background: #00ffff;
    image: url(skin:/../TrackStarM3/buttons/btn_vinyl_pass_right.svg) no-repeat top center;
    }
    #VinylTogglerRightPassthrough[displayValue="0"]:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_vinyl_pass_right_hover.svg) no-repeat top center;
    }

  #VinylControlButton,
  #VinylControlStatus,
  #VinylModeButton,
  #VinylCueModeButton,
  #PassthroughButton {
    }
  #PassthroughButton {
    margin: 0px 0px 1px 1px;
    }
  #VinylControlButton[displayValue="0"],
  #VinylModeButton,
  #VinylCueModeButton,
  #PassthroughButton {
    font-size: 11px/11px;
    color: #C4C6D0;
    background-color: #2E3136;
    }
    #VinylControlButton:hover,
    #VinylModeButton:hover {
      border: 1px solid #C4C6D0;
    }
    #PassthroughButton[displayValue="0"]:hover {
      border: 1px solid #AAC7FF;
    }
  #VinylModeButton[displayValue="1"],
  #VinylModeButton[displayValue="2"],
  #VinylControlButton[displayValue="1"] {
    color: #E2E2E9;
    font-weight: normal;
    } /*
  #VinylModeButton[displayValue="1"],
  #VinylModeButton[displayValue="2"], */
  #VinylControlStatus[displayValue="0"] {
    background-color: #44474F;
    }
  #VinylControlButton[displayValue="1"] {
    background-color: transparent;
    }
  #VinylControlStatus[displayValue="1"] {
    background-color: #468c00;
  }
  #VinylControlStatus[displayValue="2"] {
    background-color: #AAC7FF;
  }
  #VinylControlStatus[displayValue="3"] {
    background-color: #FFB4AB;
  }
  #PassthroughButton[displayValue="1"] {
    color: #111318;
    font-weight: normal;
    background-color: #AAC7FF;
    }
    #PassthroughButton[displayValue="1"]:hover {
      border: 1px solid #fff;
    }

  #DeckRowCommentFx {
    qproperty-layoutAlignment: 'AlignVCenter';
    background-color: #111318;
  }
  WLabel#TrackComment {
    /* Note(ronso0):
    defining font-size here breaks top alignment  */
    padding-left: 1px;
    /* Note(ronso0):
    Somehow this is necessary to display multi-line comments correctly.
    Without it, first line would be cropped. */
    padding-top: 1px;
    color: #C4C6D0;
    text-align: left;
    background-color: #2E3136;
    }

#DeckRowText {
  qproperty-layoutAlignment: 'AlignTop';
  background-color: #2E3136;
  padding: 3px 8px 4px 8px;
  }
  #PlayPosition, #TrackTitle {
    font-size: 18px/18px;
    font-weight: normal;
    padding: 3px 5px;
  }
  #TrackTitle {
    color: #AAC7FF;
    font-size: 16px/18px;
    padding: 0px 5px 0px 5px;
    qproperty-wordWrap: true;
    qproperty-alignment: 'AlignLeft | AlignTop';
  }
  #Duration, #TrackBy, #TrackArtist, #TrackTitleMini, #PlayPositionMini {
    font-size: 16px/16px;
    font-weight: normal;
    padding: 3px 5px;
  }
  #PlayPosition, #PlayPositionMini {
    /* Draw a border to emphasize that play position display can be changed
    to show both elapsed and remaining time */
    border: 1px solid transparent;
    }
  #PlayPosition {
    padding: 0px 0px 0px 1px;
    color: #ffffff;
    font-size: 13px/13px;
    }
  #PlayPositionMini {
    padding: 0px 1px 0px 0px;
    }
    #PlayPosition:hover,
    #PlayPositionMini:hover,
    WTrackProperty:hover,
    WTrackProperty:hover[selected="false"],
    WTrackProperty[selected="true"] {
      border: 1px solid #C4C6D0;
    }
    WTrackProperty:hover[selected="true"] {
      border: 1px solid #fff;
    }
  #TrackTitleMini {
    padding: 0px 0px 0px 1px;
  }
  #TrackArtist {
    padding-top: 1px;
    font-size: 11px/11px;
    color: #ffffff;
  }
  WLabel#TrackBy, WLabel#TrackByMini {
    color: #C4C6D0;
  }
  WLabel#TrackByMini {
    padding: 2px 6px 0px 6px;
  }
  #LoopIndicator:hover {
    border: 1px solid #fff;
    }
    #LoopIndicator[displayValue="1"] {
      image: url(skin:/../TrackStarM3/buttons/btn_reloop_on.svg) no-repeat center center;
    }

#DeckRowTransport {
  background-color: #111318;
  }
  #DeckControlsLeft {
    qproperty-layoutAlignment: 'Alignleft | AlignVCenter';
    padding: 1px 0px 1px 1px;
    background-color: #2E3136;
  }
  #DeckControlsRight {
    qproperty-layoutAlignment: 'AlignRight | AlignVCenter';
    padding: 1px 1px 1px 0px;
    background-color: #2E3136;
    border-radius: 0px;
  }

#DeckControlsExpandedLeft,
#DeckControlsExpandedRight,
#DeckButton:hover,
#DeckControlsToggle_Left[displayValue="1"],
#DeckControlsToggle_Right[displayValue="1"] {
  background-color: #1D2024;
}
#DeckButtonExpanded:hover {
  background-color: #000;
}
#DeckControlsExpandedLeft {
  border-radius: 0px;
  border-top-right-radius: 3px;
  border-bottom-right-radius: 3px;
}
#DeckControlsExpandedRight {
  border-radius: 0px;
  border-bottom-left-radius: 3px;
  border-top-left-radius: 3px;
}
#DeckControlsToggle_Left[displayValue="1"] {
  border-top-right-radius: 0px;
  border-bottom-right-radius: 0px;
}
#DeckControlsToggle_Right[displayValue="1"] {
  border-top-left-radius: 0px;
  border-bottom-left-radius: 0px;
}

  #DeckControlsToggle_Left[displayValue="0"],
  #MainHeadMixerToggle[displayValue="0"] {
    image: url(skin:/../TrackStarM3/buttons/btn_arrow_right.svg) no-repeat center center;
    }
    #DeckControlsToggle_Left[displayValue="0"]:hover,
    #MainHeadMixerToggle[displayValue="0"]:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_arrow_right_hover.svg) no-repeat center center;
    }
    #DeckControlsToggle_Left[displayValue="1"],
    #MainHeadMixerToggle[displayValue="1"] {
      image: url(skin:/../TrackStarM3/buttons/btn_arrow_left.svg) no-repeat center center;
    }
    #DeckControlsToggle_Left[displayValue="1"]:hover,
    #MainHeadMixerToggle[displayValue="1"]:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_arrow_left_hover.svg) no-repeat center center;
    }

  #DeckControlsToggle_Right[displayValue="0"] {
    image: url(skin:/../TrackStarM3/buttons/btn_arrow_left.svg) no-repeat center center;
    }
    #DeckControlsToggle_Right[displayValue="0"]:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_arrow_left_hover.svg) no-repeat center center;
    }
    #DeckControlsToggle_Right[displayValue="1"] {
      image: url(skin:/../TrackStarM3/buttons/btn_arrow_right.svg) no-repeat center center;
    }
    #DeckControlsToggle_Right[displayValue="1"]:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_arrow_right_hover.svg) no-repeat center center;
    }

  #Keylock[displayValue="1"]:hover {
    border: 1px solid #C4C6D0;
  }

  #DeckStars:hover {
    background-color: #1D2024;
    border-radius: 2px;
    }
  /* Starrating in deck_buttons.xml for loaded tracks */
  WStarRating {
    margin: 0px;
    padding: 4px;
    color: #C4C6D0;
    background-color: none;
    }

/*################################################################
 #######  Play, Cue and HotCue buttons  #########################
##############################################################*/

/* Actual Play button. Receives click events, turns red
  when playing regularly, not from Cue or HotCue */
#PlayCue[displayValue="0"] {
  background-color: transparent;
  }
  #SamplerPlayCueUnderlay[displayValue="1"] {
    background: #93000A;
  }

/* Play/Pause + Cue naast de spinny, in DDJ-FLX4-stijl:
   afgeronde 'pad'-knop met het icoon/letter in het midden. */
#SpinnyPlayButton,
#SpinnyCueButton {
  border-radius: 8px;
  border: 1px solid #5a6573;
  font-size: 15px;
  font-weight: normal;
  color: #0A305F;
  }
/* Play: licht in pauze, groen tijdens spelen */
#SpinnyPlayButton[displayValue="0"] {
  background-color: #E2E2E9;
  }
#SpinnyPlayButton[displayValue="1"] {
  background-color: #AAC7FF;
  }
/* Cue: licht, oranje als de afspeelpositie op het cue-punt staat */
#SpinnyCueButton[displayValue="0"] {
  background-color: #E2E2E9;
  }
#SpinnyCueButton[displayValue="1"] {
  background-color: #EBC274;
  }
#SpinnyPlayButton:hover,
#SpinnyCueButton:hover {
  border: 1px solid #EBC274;
  }

#PassthroughPlayCover {
  background-color: transparent;
  image: url(skin:/../TrackStarM3/buttons/btn_mic_aux_mute.svg) no-repeat center center;
}

#MicTalkover,
#AuxEnable {
  background-color: transparent;
  image: url(skin:/../TrackStarM3/buttons/btn_mic_aux_mute.svg) no-repeat center center;
}

#PlayCue[displayValue="0"]:hover,
#MicTalkover[displayValue="0"]:hover,
#AuxEnable[displayValue="0"]:hover,
#MicAuxAdd[displayValue="0"]:hover {
  border: 1px solid #EBC274;
  }
  #SamplerDeck #PlayCue[displayValue="0"]:hover {
    background-color: rgba(255, 128, 0, 210);
  }

#PlayCue[displayValue="1"],
#PlayIndicator[value="1"],
#MicTalkover[displayValue="1"],
#AuxEnable[displayValue="1"],
#PassthroughPlayCover,
#LoopIndicator {
  background-color: #AAC7FF;
  border: 1px solid #EBC274;
  }
  #PreviewIndicator[value="1"] {
    border: 3px solid #EBC274;
  }
  #PreviewPlay #PreviewIndicator {
    background-color: #2E3136;
  }
  #PlayCue[displayValue="1"]:hover,
  #SamplerPlayCue[displayValue="1"]:hover,
  #MicTalkover[displayValue="1"]:hover,
  #AuxEnable[displayValue="1"]:hover {
    border: 1px solid #E2E2E9;
  }

#MicTalkover[displayValue="0"],
#AuxEnable[displayValue="0"],
#MicAuxAdd[displayValue="0"] {
  background-color: #9A9CA6;
  border: 1px solid #111318;
  }
/* The button which signals alternate play status when
  playing from Cue/HotCue */
#PlayUnderlay[displayValue="0"] {
  }
  #PlayUnderlay[displayValue="1"] {
    border: 1px solid #AAC7FF;
  }

#MicAuxAdd {
  font: 17px;
  font-weight: normal;
  color: #111318;
}

#HotCues_Sampler_Preview {
  qproperty-layoutAlignment: 'AlignBottom';
  background-color: #111318;
}

#HotcueButton,
#CueButton {
  font-size: 14px/16px;
  font-weight: normal;
  }
#SpecialCueButton {
  font-size: 12px/14px;
  font-weight: normal;
  }
  #SpecialCueButton[displayValue="0"],
  #HotcueButton[displayValue="0"],
  #CueUnderlay,
  #PlayIndicator[value="0"] {
    color: #C4C6D0;
    background-color: #2E3136;
    }
  #SpecialCueButton[displayValue="0"]:hover,
  #HotcueButton[displayValue="0"]:hover,
  #CueButton[displayValue="0"]:hover {
    border: 1px solid #C4C6D0;
    }
  #SpecialCueButton[displayValue="1"],
  #HotcueButton[displayValue="1"],
  #CueButton[displayValue="1"],
  #CueUnderlay[displayValue="1"] {
    color: #E2E2E9;
    background-color: #44474F;
    }
  #SpecialCueButton[displayValue="1"]:hover,
  #HotcueButton[displayValue="1"]:hover,
  #CueButton[displayValue="1"]:hover {
    border: 1px solid #E2E2E9;
    }

#HotcueButton[light="true"] {
    color: #111318;
}
#HotcueButton[light="true"]:hover {
    border: 1px solid #808080;
}

#HotcueButton[light="true"][type="loop"] {
  image: url(skin:/../TrackStarM3/buttons/btn_hotcue_loop_dark.svg) no-repeat;
}
#HotcueButton[dark="true"][type="loop"] {
  image: url(skin:/../TrackStarM3/buttons/btn_hotcue_loop_light.svg) no-repeat;
}

/* Transparante klik-overlays voor de slimme hotcue-splitsing:
   vangen de klik (loop->gotoandloop / cue->gotoandplay) maar tonen
   de HotcueButton eronder (kleuren + loop-icoon blijven zichtbaar). */
#HotcueClickOverlay,
#HotcueClickOverlay:hover {
  background: transparent;
  border: none;
  image: none;
}

#CueButton {
/* is styled like #HotcueButton, lights up if play position
  is at main Cue point  */
  color: #C4C6D0;
  background-color: #2E3136;
}

/*################################################################
 #######  Loop Controls  ########################################
##############################################################*/

#LoopBeatJumpContainer {
  background-color: #191C20;
}

#LoopBeatJumpButton,
#LoopSizeButton {
  font-weight: normal;
  color: #C4C6D0;
  background-color: #2E3136;
  }
  #LoopSizeButton {
    font-size: 14px/12px;
  }
  #LoopBeatJumpButton:hover,
  #LoopSizeButton:hover {
    border: 1px solid #C4C6D0;
  }
  #LoopSizeButton[displayValue="1"] {
    border: 1px solid #AAC7FF;
    color: #C4C6D0;
  }
  #LoopSizeButton[displayValue="1"]:hover {
    border: 1px solid #E2E2E9;
  }

#ReloopButton[displayValue="0"] {
  background-color: #2E3136;
  }
  #ReloopButton[displayValue="0"]:hover {
    border: 1px solid #AAC7FF;
  }
  #ReloopButton[displayValue="1"] {
  /* See also #LoopIndicator */
    background-color: #AAC7FF;
    }
    #ReloopButton[displayValue="1"]:hover {
      border: 1px solid #E2E2E9;
    }

#LoopActivateButton[displayValue="0"] {
  background-color: #2E3136;
  }
  #LoopActivateButton[displayValue="0"]:hover {
    border: 1px solid #AAC7FF;
  }
  #LoopActivateButton[displayValue="1"] {
    /* See also #LoopIndicator
      background-color: #AAC7FF; */
      border: 1px solid #AAC7FF;
      background-color: #111318;
    }

WBeatSpinBox,
#spinBoxTransition {
  /* Note(ronso0):
  make it 2px smaller in each dimension,
  border is added for final size.
  Disabled since it prevents correct skin scaling
  min-width: 52px;
  max-width: 52px;
  min-height: 20px;
  max-height: 20px; */
  border: 1px solid #44474F;
  border-radius: 2px;
  color: #C4C6D0;
  background-color: #111318;
  selection-color: #111318;
  selection-background-color: #C4C6D0;
  font-size: 13px/13px;
  }
  WBeatSpinBox {
    /* Note(ronso0):
    Apparently, a top and bottom padding needs to be set to make
    the spinbox expand vertically to available 22px */
    padding: 1px 0px 1px 3px;
    margin: 0px 15px 0px 0px;
  }
  #spinBoxTransition {
    /* Note(ronso0):
    Individual padding/margin in AutoDJ feature */
    padding: -1px 3px -1px 3px;
    margin: 0px 17px 3px 3px;
  }
  WBeatSpinBox:hover,
  #spinBoxTransition:hover {
    border-color: #C4C6D0;
  }
  WBeatSpinBox:focus,
  #spinBoxTransition:focus {
    border-color: #AAC7FF;
    color: #C4C6D0;
  }

  WBeatSpinBox::up-button,
  WBeatSpinBox::down-button,
  #spinBoxTransition::up-button,
  #spinBoxTransition::down-button {
    subcontrol-origin: padding;
    position: relative;
    background-color: #191C20;
    border: 1px solid #191C20;
    border-width: 1px 0px 1px 0px;
    }
    WBeatSpinBox::up-button:hover,
    WBeatSpinBox::down-button:hover,
    #spinBoxTransition::up-button:hover,
    #spinBoxTransition::down-button:hover {
      background-color: #111318;
      }

  WBeatSpinBox::up-button,
  #spinBoxTransition::up-button {
    subcontrol-position: center right;
    /* Note(ronso0):
    Regularly, up/down buttons would be stacked vertically.
    Here, they're both aligned 'center right' and have the same size.
    This would make them overlap so we need to move one of those two
    buttons out of the way: */
    right: -16px;
    image: url(skin:/../TrackStarM3/buttons/btn_beatbox_up.svg) no-repeat;
    }
    WBeatSpinBox::up-button:hover,
    #spinBoxTransition::up-button:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_beatbox_up_hover.svg) no-repeat;
    }
  WBeatSpinBox::down-button,
  #spinBoxTransition::down-button {
    subcontrol-position: center right;
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
    image: url(skin:/../TrackStarM3/buttons/btn_beatbox_down.svg) no-repeat;
    }
    WBeatSpinBox::down-button:hover,
    #spinBoxTransition::down-button:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_beatbox_down_hover.svg) no-repeat;
    }

/*################################################################
 #######  Rate Container  #######################################
##############################################################*/

#RateContainer1,
#RateContainer2,
#RateContainer3,
#RateContainer4,
#Bpm {
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
}

#RateControls {
  background-color: #111318;
  border-radius: 3px;
}

#KeyDisplayMatch, #KeyControls {
}
#RateButtons {
  /*margin-top: 1px;*/
}

#Bpm, #KeyDisplayMatch,
#RateUp, #RateDown,
#KeyUp, #KeyDown,
#PitchSliderGroup {
  background-color: #282A2F;
  border-radius: 3px;
}
#BpmLabel,
#BpmLabelMini {
  qproperty-alignment: 'AlignHCenter | AlignVCenter';
  font-size: 16px/16px;
  font-weight: normal;
  text-align: center;
  padding-top: 1px;
  }
  #BpmLabel {
    background-color: #282A2F;
    font-size: 40px;
    color: #1ad9b7;
  }
  WNumber#BpmHuge {
    qproperty-alignment: 'AlignHCenter | AlignVCenter';
    font-size: 24px;
    font-weight: normal;
    color: #AAC7FF;
    background-color: #2E3136;
  }
  WKey#KeyHuge {
    qproperty-alignment: 'AlignHCenter | AlignVCenter';
    font-size: 18px;
    font-weight: normal;
    color: #EBC274;
    background-color: #2E3136;
    border-left: 1px solid #1d1d1d;
  }
  #BpmLabelMini {
    background-color: #282A2F;
  }
  #SyncButtonOverlay[displayValue="0"]:hover,
  #SyncButtonOverlayMini[displayValue="0"]:hover {
    image: url(skin:/../TrackStarM3/buttons/btn_key_match_hover.svg) no-repeat center center;
  }
  #SyncButtonOverlay[displayValue="0"] {
    border: 1px solid #44474F;
  }
  #SyncButtonOverlayMini[displayValue="0"],
  #KeyMatchMini {
    border: 1px solid #191C20;  /*
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    border-bottom: 1px solid #2E3136;  */
    margin-bottom: 1px;
  }
  #SyncButtonOverlay[displayValue="0"]:hover,
  #SyncButtonOverlayMini[displayValue="0"]:hover,
  #KeyMatch:hover,
  #KeyMatchMini:hover {
    background-color: rgba(56,66,82,180);
    border: 1px solid #FFB4AB;
  }
  #SyncButtonOverlay[displayValue="1"],
  #SamplerSyncButton[displayValue="1"] {
    border: 1px solid #FFB4AB;
    color: #E2E2E9;
  }
  #SyncButtonOverlay[displayValue="1"]:hover,
  #SamplerSyncButton[displayValue="1"]:hover {
    border: 1px solid #E2E2E9;
  }

    #RateUp:hover, #RateDown:hover,
    #KeyUp:hover, #KeyDown:hover {
      background-color: #2E3136;
    }
  #RateUp {
    image: url(skin:/../TrackStarM3/buttons/btn_rate_up.svg) no-repeat center center;
    }
    #RateUp:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_rate_up_hover.svg) no-repeat center center;
    }
  #RateDown {
    image: url(skin:/../TrackStarM3/buttons/btn_rate_down.svg) no-repeat center center;
    }
    #RateDown:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_rate_down_hover.svg) no-repeat center center;
    }

  #KeyDisplay, #KeyDisplayMini {
    font-size: 14px/14px;
  }
  #KeyDisplay {
    padding: 0px;
  }
  #KeyDisplayMini {
    padding: 0px 0px 0px 0px;
  }
  #KeyMatch {
    border: 1px solid #44474F;
  }
    #KeyMatch:hover,
    #KeyMatchMini:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_key_match_hover.svg) no-repeat center center;
    }
    #KeyUp {
      image: url(skin:/../TrackStarM3/buttons/btn_key_up.svg) no-repeat center center;
      }
      #KeyUp:hover {
        image: url(skin:/../TrackStarM3/buttons/btn_key_up_hover.svg) no-repeat center center;
      }
    #KeyDown {
      image: url(skin:/../TrackStarM3/buttons/btn_key_down.svg) no-repeat center center;
      }
      #KeyDown:hover {
        image: url(skin:/../TrackStarM3/buttons/btn_key_down_hover.svg) no-repeat center center;
      }

#RateDisplayBox {
  padding: 0 3px 0 5px;
}


/* ################################################################
####### Deck Colors ##################################################
###############################################################*/
#Deck1 WLabel, #DeckMini1 WLabel,
#Deck2 WLabel, #DeckMini2 WLabel,
#RateContainer1 WLabel, #RateContainer1 WPushButton,
#RateContainer2 WLabel, #RateContainer2 WPushButton {
  color: #C4C6D0;
}
#Deck3 WLabel, #DeckMini3 WLabel,
#Deck4 WLabel, #DeckMini4 WLabel,
#RateContainer3 WLabel, #RateContainer3 WPushButton,
#RateContainer4 WLabel, #RateContainer4 WPushButton {
  color: #7DBF36;
}
/* Songtitel felgroen (hogere specificiteit dan #DeckN WLabel) */
#Deck1 #TrackTitle, #Deck2 #TrackTitle,
#Deck3 #TrackTitle, #Deck4 #TrackTitle {
  color: #AAC7FF;
}
WLabel#TrackBy,
WLabel#TrackByMini,
WLabel#TrackComment {
  color: #C4C6D0;
}
#DeckOverviewRow1, #DeckOverviewRow2 {
  background-color: #C4C6D0;
}
#DeckOverviewRow3, #DeckOverviewRow4 {
  background-color: #19260B;
}


/*################################################################
 #######  Channel Mixer  ########################################
##############################################################*/
#MixerChannelLeft {
  qproperty-layoutAlignment: 'AlignRight | AlignTop';
  background-color: #2E3136;
  border-bottom-right-radius: 3px;
}
#MixerChannelRight {
  qproperty-layoutAlignment: 'AlignRight | AlignTop';
  background-color: #2E3136;
  border-bottom-left-radius: 3px;
}

#VolumeSliderGain {
  qproperty-layoutAlignment: 'AlignHCenter';
  margin-top: 2px;
}

#GainKnob {
  margin: 2px;
}
#SuperWetDryKnob {
  qproperty-layoutAlignment: 'AlignVCenter | AlignHCenter';
  margin: 0px;
}
#FxMetaknob {
  qproperty-layoutAlignment: 'AlignVCenter | AlignHCenter';
  margin: 0px;
}

#MixModeButton {
  border: 1px solid #111318;
  }
  #MixModeButton:hover {
    background-color: #1D2024;
  }

#EQKnobContainerLeft {
  qproperty-layoutAlignment: 'AlignLeft | AlignTop';
  margin: 0px 2px 0px 4px;
}
#EQKnobContainerRight {
  qproperty-layoutAlignment: 'AlignRight | AlignTop';
  margin: 0px 4px 0px 2px;
}

#EQKillButton {
  margin: 1px 0px 2px 0px;
  }
  #EQKillButton[displayValue="0"] {
    background-color: #44474F;
    }
    #EQKillButton[displayValue="0"]:hover {
      border: 1px solid #FFB4AB;
    }
  #EQKillButton[displayValue="1"] {
    background-color: #93000A;
    }
    #EQKillButton[displayValue="1"]:hover {
      border: 1px solid #C4C6D0;
    }

/* Kill indicators underneath EQ knobs */
#EQKilledUnderlay[displayValue="1"] {
  image: url(skin:/../TrackStarM3/knobs_sliders/knob_eq_killed.svg) no-repeat center center;
}
#QuickFxDisabledUnderlay[displayValue="0"] {
  image: url(skin:/../TrackStarM3/knobs_sliders/knob_quickFX_disabled.svg) no-repeat center center;
}

#QuickFXSide {
  padding: 0px;
}
#QuickFXBottom {
  padding: 0px 2px 4px 2px;
}

#QuickFXButton[displayValue="0"] {
  background-color: #44474F;
  }
  #QuickFXButton[displayValue="0"]:hover {
    border: 1px solid #AAC7FF;
    }
#QuickFXButton[displayValue="1"] {
  background-color: #C4C6D0;
  border: 1px solid #AAC7FF;
  }
  #QuickFXButton[displayValue="1"]:hover {
    border: 1px solid #E2E2E9;
  }

/*  This wouldn't scale the image:
#PflButton[displayValue="0"] {
  background: transparent url(skin:/../TrackStarM3/buttons/btn_pfl_off.svg) no-repeat center center;
  background-origin: padding;
  }
  This is a workaround to scale and center the image, but image would appear blurred
  if it is scaled up too much (>120). Source:
  https://forum.qt.io/topic/40151/solved-scaled-background-image-using-stylesheet/6
  border-image: url(skin:/../TrackStarM3/buttons/btn_pfl_off.svg) 0 0 0 0 stretch stretch; */
#PflBoxLeft,
#PflBoxRight {
  background-color: #111318;
  border-color: #111318;
  border-style: solid;
  border-radius: 3px;
  }
  #PflBoxLeft {
    border-width: 1px 0px 0px 1px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 0px;
  }
  #PflBoxRight {
    border-width: 1px 1px 0px 0px;
    border-bottom-right-radius: 0px;
    border-top-left-radius: 0px;
  }

/* this style is applied to all Pfl buttons in
decks, samplers, mic, aux, fx */
#PflButton[displayValue="0"] {
  background-color: #2E3136;
}
#PflButton[displayValue="1"] {
  background-color: #111318;
}
#PflButton[displayValue="0"]:hover,
#PflButton[displayValue="1"]:hover {
  background-color: #1D2024;
}

#FxUnitMixerLeft_mini WPushButton[displayValue="0"],
#FxUnitMixerRight_mini WPushButton[displayValue="0"],
#FxUnitMixerLeft WPushButton[displayValue="0"],
#FxUnitMixerRight WPushButton[displayValue="0"],
#SamplerDeck #PflButton {
  border: 1px solid #1D2024;
  }
  #SamplerDeck #PflButton {
    border-width: 0px 1px 0px 1px;
    border-radius: 0px;
  }
  #FxUnitMixerLeft_mini WPushButton[displayValue="1"],
  #FxUnitMixerRight_mini WPushButton[displayValue="1"],
  #FxUnitMixerLeft WPushButton[displayValue="1"],
  #FxUnitMixerRight WPushButton[displayValue="1"],
  #FxUnitMixerLeft_mini WPushButton[displayValue="0"]:hover,
  #FxUnitMixerRight_mini WPushButton[displayValue="0"]:hover,
  #FxUnitMixerLeft WPushButton[displayValue="0"]:hover,
  #FxUnitMixerRight WPushButton[displayValue="0"]:hover {
    border: 1px solid #1D2024;
  }

#VUMeterMixer {
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
  margin-top: 3px;
}

#VUMeterFloating {
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
  padding: 3px 0px 1px 0px;
  background-color: #282A2F;
  border-radius: 3px;
}

#VUMeterSampler {
  padding: 0px 2px 0px 0px;
}

#VuMeterClippingBorder[highlight="0"] {
  border: 1px solid transparent;
  }
  #VuMeterClippingBorder[highlight="1"] {
    border: 1px solid #fff;
  }

#VUMeterLabelMain {
  image: url(skin:/../TrackStarM3/buttons/btn_main_vu_label.svg) no-repeat center center;
}
#VUMeterLabelDeck1 {
  image: url(skin:/../TrackStarM3/buttons/btn_deck1_vu_label.svg) no-repeat center center;
}
#VUMeterLabelDeck2 {
  image: url(skin:/../TrackStarM3/buttons/btn_deck2_vu_label.svg) no-repeat center center;
}
#VUMeterLabelDeck3 {
  image: url(skin:/../TrackStarM3/buttons/btn_deck3_vu_label.svg) no-repeat center center;
}
#VUMeterLabelDeck4 {
  image: url(skin:/../TrackStarM3/buttons/btn_deck4_vu_label.svg) no-repeat center center;
}


/*################################################################
######  Effects  ###############################################
##############################################################*/

#FxUnitLabel {
  /* not respected
  qproperty-alignment: center;
  text-align: center;*/
  font-size: 14px;
  font-weight: normal;
  color: #C4C6D0;
}

#FixedLoopSizesMiniMaxi {
  image-position: center center;
}
#SamplersMiniMaxi {
  image-position: top center;
}

#FxUnitLeft #FxMiniMaxi {
  image-position: bottom left;
  margin: 1px 0 1px 10px;
}
#FxUnitRight #FxMiniMaxi {
  image-position: bottom right;
  margin: 1px 10px 1px 0;
  }
  #FxUnitMini #FxMiniMaxi {
    image-position: bottom center;
    margin-top: 14px;
  }

#FxUnitLeft #FxUnitLabel {
  padding-left: 30px;
}


#FixedLoopSizesMiniMaxi[displayValue="0"],
#FxMiniMaxi[displayValue="0"],
#SamplersMiniMaxi[displayValue="0"] {
  image: url(skin:/../TrackStarM3/buttons/btn_arrow_down.svg)
  }
  #FixedLoopSizesMiniMaxi[displayValue="0"]:hover,
  #FxMiniMaxi[displayValue="0"]:hover,
  #SamplersMiniMaxi[displayValue="0"]:hover {
    image: url(skin:/../TrackStarM3/buttons/btn_arrow_down_hover.svg);
  }
#FixedLoopSizesMiniMaxi[displayValue="1"],
#FxMiniMaxi[displayValue="1"],
#SamplersMiniMaxi[displayValue="1"] {
  image: url(skin:/../TrackStarM3/buttons/btn_arrow_up.svg);
  }
  #FixedLoopSizesMiniMaxi[displayValue="1"]:hover,
  #FxMiniMaxi[displayValue="1"]:hover,
  #SamplersMiniMaxi[displayValue="1"]:hover {
    image: url(skin:/../TrackStarM3/buttons/btn_arrow_up_hover.svg);
  }

#FxUnitControls {
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
  background-color: #282A2F;
}

#FxUnitMixerLeft,
#FxUnitMixerRight,
#FxUnitMixerLeft_mini,
#FxUnitMixerRight_mini {
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
/*  qproperty-layoutAlignment: 'AlignHCenter';*/
  background-color: #2E3136;
  }
#FxUnitMixerLeft,
#FxUnitMixerRight {
    padding: 2px;
    border-radius: 0px;
  }
#FxUnitMixerLeft {
  border-bottom-right-radius: 2px;
  border-left: 1px solid #111318;
}
#FxUnitMixerRight {
  border-bottom-left-radius: 2px;
  border-right: 1px solid #111318;
}
  #FxUnitMixerLeft_mini {
    padding-left: 2px;
  }
  #FxUnitMixerRight_mini {
    padding-right: 2px;
  }

/* effect slots backgrounds & separators indicating the effect flow */
/* no focus */
#FxFlow_mini_separator {
  background-color: transparent;
  image: url(skin:/../TrackStarM3/graphics/fxFlow_mini_noFocus_Fx1-2-3.svg) no-repeat center center;
}
#FxFlow_maxi_separator {
  background-color: transparent;
  border-radius: 0px;
  image: url(skin:/../TrackStarM3/graphics/fxFlow_maxi_noFocus_Fx1-2-3.svg) no-repeat right center;
}

#FxFlow_focus_background,
/* with focus */
#FxFlow_focus_background[highlight="0"] {
  background-color: #2E3136;
  border-radius: 0px;
  }
  #FxFlow_focus_background[highlight="1"] {
    background-color: transparent;
  border-radius: 0px;
  }
/* collapsed effect slots, horizontal layout */
#FxFlow_mini_focus_separator1-2[highlight="0"],
#FxFlow_mini_focus_separator1-2[highlight="3"],
#FxFlow_mini_focus_separator2-3[highlight="0"],
#FxFlow_mini_focus_separator2-3[highlight="1"] {
  background-color: transparent;
  image: url(skin:/../TrackStarM3/graphics/fxFlow_mini_noFocus_Fx1-2-3.svg) no-repeat center center;
  }
  #FxFlow_mini_focus_separator1-2[highlight="1"],
  #FxFlow_mini_focus_separator2-3[highlight="2"] {
    background-color: transparent;
    image: url(skin:/../TrackStarM3/graphics/fxFlow_mini_focus_left.svg) no-repeat center center;
  }
  #FxFlow_mini_focus_separator1-2[highlight="2"],
  #FxFlow_mini_focus_separator2-3[highlight="3"] {
    background-color: transparent;
    image: url(skin:/../TrackStarM3/graphics/fxFlow_mini_focus_right.svg) no-repeat center center;
  }

/* expanded effect slots, vertical layout */
#FxFlow_maxi_focus_separator1-2[highlight="0"],
#FxFlow_maxi_focus_separator1-2[highlight="3"],
#FxFlow_maxi_focus_separator2-3[highlight="0"],
#FxFlow_maxi_focus_separator2-3[highlight="1"] {
  background-color: transparent;
  image: url(skin:/../TrackStarM3/graphics/fxFlow_maxi_noFocus_Fx1-2-3.svg) no-repeat center center;
  }
  #FxFlow_maxi_focus_separator1-2[highlight="1"],
  #FxFlow_maxi_focus_separator2-3[highlight="2"] {
    background-color: transparent;
    image: url(skin:/../TrackStarM3/graphics/fxFlow_maxi_focus_top.svg) no-repeat center center;
  }
  #FxFlow_maxi_focus_separator1-2[highlight="2"],
  #FxFlow_maxi_focus_separator2-3[highlight="3"] {
    background-color: transparent;
    image: url(skin:/../TrackStarM3/graphics/fxFlow_maxi_focus_bottom.svg) no-repeat center center;
  }
/* /effect slot focus indicators */

#FxFocusButton {
  background-color: transparent;
}
  #FxFocusButton[displayValue="0"] {
    image: url(skin:/../TrackStarM3/buttons/btn_fx_focus_off.svg) no-repeat center center;
    }
    #FxFocusButton[displayValue="0"]:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_fx_focus_off_hover.svg) no-repeat center center;
    }
  #FxFocusButton[displayValue="1"] {
    image: url(skin:/../TrackStarM3/buttons/btn_fx_focus_on.svg) no-repeat center center;
    }
    #FxFocusButton[displayValue="1"]:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_fx_focus_on_hover.svg) no-repeat center center;
    }

#FxMetaknob {
  /* Should shift Meta knob 2px down.
  Not working, although it works for Gain knob...
  margin: 0px 0px -2px 0px; */
}

#FxToggleSelector {
  /* stacked layout for toggle, effect name, feedback underlay & EffectSelector */
  qproperty-layoutAlignment: 'AlignLeft | AlignVCenter';
  border-radius: 3px;
  }
  #FxToggleButton[displayValue="0"]:hover {
    border: 1px solid #AAC7FF;
    }
    #FxToggleButton[displayValue="1"]:hover {
      border: 1px solid #fff;
      }
  #FxToggleButtonUnderlay[displayValue="0"] {
    background-color: #C4C6D0;
    }
    #FxToggleButtonUnderlay[displayValue="1"] {
      background-color: #AAC7FF;
      }

  #FxNameContainer {
    padding: 1px 2px 1px 1px;
    qproperty-layoutAlignment: 'AlignLeft';
    }
    #FxName {
      qproperty-alignment: 'AlignLeft | AlignVCenter';
      color: #000;
      text-align: left;
      font-size: 13px/12px;
    }

  /* ---- Per-deck BEAT-FX indicator (decks/deck_fx_indicator.xml) ---- */
  #DeckFxBar {
    qproperty-layoutAlignment: 'AlignLeft | AlignVCenter';
    }
  #DeckFxTag {
    color: #9A9CA6;
    font-size: 12px;
    font-weight: bold;
    qproperty-alignment: 'AlignCenter';
    }
  #DeckFxPill {
    border-radius: 4px;
    }
  #DeckFxNameBox {
    padding: 1px 6px 1px 6px;
    qproperty-layoutAlignment: 'AlignLeft | AlignVCenter';
    }
    #DeckFxName {
      qproperty-alignment: 'AlignLeft | AlignVCenter';
      color: #07210f;
      text-align: left;
      font-size: 13px;
      }
  #DeckFxUnderlay {
    border-radius: 4px;
    }
  #DeckFxUnderlay[displayValue="0"] {
    background-color: #C4C6D0;
    }
    #DeckFxUnderlay[displayValue="1"] {
      background-color: #AAC7FF;
      }
  #DeckFxToggle[displayValue="0"]:hover {
    border: 1px solid #AAC7FF;
    border-radius: 4px;
    }
    #DeckFxToggle[displayValue="1"]:hover {
      border: 1px solid #fff;
      border-radius: 4px;
      }

  WEffectSelector,
  WEffectChainPresetSelector,
  #fadeModeCombobox {
    font-size: 13px/13px;
    /* On Linux this is applied to both effect name and effect list. */
    }
    WEffectSelector,
    WEffectChainPresetSelector {
      /* Fixes the white bars on the top/bottom of the popup on Mac OS X */
      margin: 0px;
      /* The 3D frame on the combo box becomes flat when you give it a border */
      border: 0px solid transparent;
      border-radius: 3px;
    }
    WEffectSelector {
      /* If you use margin top/bottom 0, the combo box shrinks in width (go figure) and
          names start getting cut off. Adding explicit padding improves this. */
      padding: 0px 28px 0px 0px;
      border-top-left-radius: 0px;
      border-bottom-left-radius: 0px;
    }
    #fadeModeCombobox {
      border: 1px solid #44474F;
      margin: 0px 0px 2px 1px;
      padding: 1px 3px;
      border-radius: 2px;
      height: 20px;
    }
    WEffectChainPresetSelector {
      /* blend with the mixer backgrpund */
      background-color: #2E3136;
      color: #C4C6D0;
      margin: 0px;
      padding: 0px;
    }

  WEffectSelector:hover {
    background-color: #111318;
  }
  WEffectChainPresetSelector:hover {
    background-color: #282A2F;
  }

  WEffectSelector::drop-down,
  WEffectChainPresetSelector::drop-down,
  #fadeModeCombobox::drop-down {
    border: 0px;
    margin: 0px;
    padding: 0px;
    }
    WEffectSelector::drop-down {
      margin-right: -2px;
    }
    /* QuickEffect selector in left-hand decks has it's down arrow
      on the left side, below the QuickEffect toggle */
    #QuickEffectSelectorLeft {
      text-align: left;
      }
      #QuickEffectSelectorLeft::drop-down {
        subcontrol-origin: margin;
        subcontrol-position: left center;
      }
    #QuickEffectSelectorRight {
      text-align: right;
      }
      #QuickEffectSelectorRight::drop-down {
        subcontrol-origin: margin;
        subcontrol-position: right center;
      }

  WEffectChainPresetButton {
    padding: 0px;
    border:  none;
    border-radius: 2px;
    background-color: #2E3136;
    image: url(skin:/../TrackStarM3/buttons/btn_skinsettings_off.svg) no-repeat center center;
    }
    WEffectChainPresetButton:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_skinsettings_on.svg) no-repeat center center;
    }
    WEffectChainPresetButton::menu-indicator {
      subcontrol-position: center center;
      subcontrol-origin: margin;
      padding: 0px;
      border: 0px;
      outline: none;
    }

  WEffectSelector::down-arrow,
  WSearchLineEdit::down-arrow,
  #fadeModeCombobox::down-arrow {
    /* With a fixed size and the skin being scaled
    * button icon is not scaled
    * bg-color is applied only to the icon rectangle
    background-color: #101010;
    width: 11px;
    height: 20px; */
    image: url(skin:/../TrackStarM3/buttons/btn_arrow_down_fx.svg) no-repeat center center;
    }
    WEffectSelector::down-arrow:hover,
    WSearchLineEdit::down-arrow:hover,
    #fadeModeCombobox::down-arrow:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_arrow_down_fx_hover.svg) no-repeat center center;
    }
  WEffectChainPresetSelector::down-arrow {
    image: url(skin:/../TrackStarM3/buttons/btn_arrow_down_fxquick.svg) no-repeat center center;
    }
    WEffectChainPresetSelector::down-arrow:hover {
      image: url(skin:/../TrackStarM3/buttons/btn_arrow_down_fxquick_hover.svg) no-repeat center center;
    }

  WEffectSelector QAbstractScrollArea,
  WEffectChainPresetSelector QAbstractScrollArea,
  WSearchLineEdit QAbstractScrollArea,
  #fadeModeCombobox QAbstractScrollArea {
    border-radius: 2px;
    margin: 0px;
  }
  WEffectSelector QAbstractScrollArea,
  WEffectChainPresetSelector QAbstractScrollArea {
    min-width: 140px;
  }
  #fadeModeCombobox QAbstractScrollArea {
    min-width: 165px;
  }
  /* selected item */
  WEffectSelector::checked,
  WEffectChainPresetSelector::checked,
  #fadeModeCombobox::checked {
    /* not applied
    padding-left: 5px;
    font-weight: normal;
    background-color: #000; */
    color: #fff;
    background-color: #8E9099;
  }
  /* tick mark frame */
  WEffectSelector::indicator:checked,
  WEffectChainPresetSelector::indicator:checked,
  #fadeModeCombobox::indicator:checked {
  /* This is sufficient to completely hide the tick mark,
    but this alone would show an empty, shadowed box instead of tick mark:  */
    /* This should decrease the tick mark's left & right margin but is not respected
    margin: 0px -4px 0px -4px; */
    /* This draws a border. And eliminates the tick mark...
    border: 1px solid #C4C6D0; */
    /* This has no effect:
    height: 10px;
    width: 10px; */
    /* Image is rendered correctly but size of the tick mark containers
    won't change. Also, only with this option the hover bg color defined
    above will be applied... it's qt magic
    background: #0081B7; */
    margin: 3px 3px 3px 6px;
    image: url(skin:/../TrackStarM3/buttons/btn_lib_checkmark_white.svg) no-repeat center center;
  }
  /* Wtf?
  This removes 3D border from unchecked effects checkmark space.
  But: his will also prevent the icons from being scaled up,
  so set desired size in the svg itself. */
  WEffectSelector::item:selected,
  WEffectChainPresetSelector::item:selected,
  #fadeModeCombobox::item:selected {
    border: 0px;
  }

#FxParametersLeft {
  qproperty-layoutAlignment: 'AlignRight';
}

#FxParametersRight {
  qproperty-layoutAlignment: 'AlignLeft';
}

#FxParameterKnob {
  padding-right: 1px;
  qproperty-layoutAlignment: 'AlignCenter';
  margin-right: 1px;
}
  #FxParameterKnobName {
    qproperty-alignment: 'AlignHCenter | AlignTop';
    font-size: 10px/10px;
    font-weight: normal;
    color: #C4C6D0;
    padding-top: -2px;
  }

#FxParameterButton {
  qproperty-layoutAlignment: 'AlignLeft | AlignVCenter';
  margin-right: 1px;
  }
  #FxParameterPushButton[displayValue="0"]:hover {
    border: 1px solid #C4C6D0;
  }
  #FxParameterPushButton[displayValue="1"]:hover {
    border: 1px solid #E2E2E9;
  }

  #FxParameterPushButton[displayValue="0"] {
    background-color: #8E9099;
  }
  #FxParameterPushButton[displayValue="1"] {
    background-color: #284777;
  }
  #FxParameterButtonName {
    font-size: 10px/10px;
    font-weight: normal;
    qproperty-alignment: 'AlignLeft | AlignVCenter';
    margin-left: 1px;
    }
    #FxParameterButtonName[highlight="0"] {
      color: #C4C6D0;
    }
    #FxParameterButtonName[highlight="1"] {
      color: #E2E2E9;
    }
#FxSuperLinkButtonBox,
#FxSuperLinkButton,
#FxSuperLinkInvertButton {
  /* those buttons are only 5px tall, that's why they won't accept
  3px radius which is set for all WPushButtons */
  border-radius: 2px;
  }
  #FxSuperLinkButtonBox {
    background-color: #282A2F;
    margin: 0px 2px 0px 1px;
    qproperty-layoutSpacing: 1;
  }
  #FxSuperLinkInvertButton {
  }

#FxSuperLinkButton[value="0"],
#FxSuperLinkInvertButton[displayValue="0"] {
  background-color: #8E9099;
}
#FxSuperLinkButton[value="0"]:hover {
  background-color: #C4C6D0;
}
#FxSuperLinkInvertButton[displayValue="1"] {
  background-color: #93000A;
  }
  #FxSuperLinkInvertButton[displayValue="1"]:hover {
    background-color: #FFB4AB;
  }

#FxSuperLinkInvertButton[displayValue="0"]:hover,
#FxSuperLinkButton[value="1"] {
  background-color: #284777;
  }
  #FxSuperLinkButton[value="1"]:hover {
    background-color: #9CCBFF;
  }
#FxSuperLinkButton[value="2"] { /*
  a simple way to achieve a partitioning in thirds  */
  background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 #284777,
    stop: 0.33 #284777,
    stop: 0.34 #8E9099,
    stop: 1 #8E9099);
  }
  #FxSuperLinkButton[value="2"]:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
      stop: 0 #9CCBFF,
      stop: 0.33 #9CCBFF,
      stop: 0.34 #8E9099,
      stop: 1 #8E9099);
    }
#FxSuperLinkButton[value="3"] {
  background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 #8E9099,
    stop: 0.66 #8E9099,
    stop: 0.67 #284777,
    stop: 1 #284777);
  }
  #FxSuperLinkButton[value="3"]:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
      stop: 0 #8E9099,
      stop: 0.66 #8E9099,
      stop: 0.67 #9CCBFF,
      stop: 1 #9CCBFF);
    }
#FxSuperLinkButton[value="4"] {
  background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 #284777,
    stop: 0.330000 #284777,
    stop: 0.340000 #8E9099,
    stop: 0.660000 #8E9099,
    stop: 0.670000 #284777,
    stop: 1 #284777);
  }
  #FxSuperLinkButton[value="4"]:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
      stop: 0 #9CCBFF,
      stop: 0.330000 #9CCBFF,
      stop: 0.340000 #8E9099,
      stop: 0.660000 #8E9099,
      stop: 0.670000 #9CCBFF,
      stop: 1 #9CCBFF);
  }

#FxAssignButton {
  font-size: 13px/13px;
  font-weight: normal;
  text-align: center;
  border-radius: 2px;
  background-color: #2E3136;
  }
  #FxAssignButton[displayValue="0"] {
    color: #C4C6D0;
    }
    #FxAssignButton[displayValue="0"]:hover {
      border: 1px solid #AAC7FF;
    }
  #FxAssignButton[displayValue="1"] {
    color: #E2E2E9;
    border: 1px solid #AAC7FF;
    }
    #FxAssignButton[displayValue="1"]:hover {
      border: 1px solid #fff;
    }

/* Main FX buttons in top bar's mixer section are
styled differently because of their importance */
#FxMainToggles {
  qproperty-layoutSpacing: 1;
}

#FxMainButton {
  font-size: 13px/13px;
  font-weight: normal;
  text-align: center;
  border-radius: 1px;
  }
  #FxMainButton[displayValue="0"] {
    color: #C4C6D0;
    background: #191C20;
    }
    #FxMainButton[displayValue="0"]:hover {
      border: 1px solid #AAC7FF;
    }
  #FxMainButton[displayValue="1"] {
    background-color: #AAC7FF;
    color: #111318;
    }
    #FxMainButton[displayValue="1"]:hover {
      border: 1px solid #fff;
    }

/*################################################################
 ######  Samplers  ##############################################
##############################################################*/

#SamplerDecks {
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
  margin-bottom: 5px;
}

#SamplerRow5 {
  margin-top: 2px;
}

#SamplerDeck {
  background-color: #2E3136;
}

#SamplerPlayBox,
#SamplerPlayBox_mini {
  background-color: #111318;
  border-radius: 3px;
  }
  #SamplerPlayBox {
    padding: 0px 1px 0px 0px;
  }
  #SamplerPlayBox_mini {
    padding: 0px 1px 0px 0px;
    }
  #SamplerCover {
    background-color: #2E3136;
    border-radius: 3px;
  }

WTrackProperty#SamplerTitle {
  font-size: 14px/18px;
  font-weight: normal;
  color: #C4C6D0;
  text-align: left;
  padding: 0 0 0 1px;
}

WTrackProperty#SamplerTitle_mini {
  font-size: 14px/14px;
  font-weight: normal;
  color: #C4C6D0;
  text-align: left;
  padding: 0px 2px 0px 0px;
}

#SamplerSyncGainPfl {
  padding: 1px;
}

#SamplerGainKnob {
  qproperty-layoutAlignment: 'AlignHCenter';
}

#SamplerButton,
#SamplerButton_mini {
  font-size: 14px/14px;
  font-weight: normal;
  text-align: center;
  color: #C4C6D0;
}
#SamplerButton_mini {
  border-radius: 2px;
  }
  #SamplerButton:hover,
  #SamplerButton_mini:hover,
  #SamplerSyncButton {
    background-color: #111318;
  }
#SamplerKeylock {
  margin-left: 3px;
}

#SamplerSyncButton:hover {
  border: 1px solid #C4C6D0;
}

/*################################################################
 ######  Spinnies  ##############################################
##############################################################*/

#SpinnyCoverContainer {
  margin: 0px;
  padding: 0px;
  background-color: #191C20;
}

/*################################################################
 ######  Preview Deck  ##########################################
##############################################################*/

#PreviewDeck {
  qproperty-layoutAlignment: 'AlignLeft | AlignTop';
  background-color: #111318;
}
#PreviewTitle,
#PreviewEject,
#PreviewGainKnob {
  background-color: #2E3136;
}
#PreviewTitleEject {
  qproperty-layoutAlignment: 'AlignLeft | AlignTop';
  margin-bottom: 1px;
}
#PreviewPlayOverview {
  qproperty-layoutAlignment: 'AlignLeft | AlignTop';
}
  #PreviewTitle {
    padding-left: 1px;
  }
  #PreviewTitle WLabel {
    font-size: 14px/14px;
    font-weight: normal;
    text-align: left;
    color: #C4C6D0;
  }
  #PreviewEject:hover {
    border: 1px solid #E2E2E9;
  }
  #PreviewPlay,
  #PreviewOverview {
    margin-right: 1px;
  }
  #PreviewGainKnob {
    qproperty-layoutAlignment: 'AlignVCenter | AlignHCenter';
  }


/*################################################################
