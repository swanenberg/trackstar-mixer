<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- TrackStar DJ Mixer: direct download build (Developer ID / ad-hoc), NOT the App Store sandbox.
         The Mixxx App Store entitlements (Mixxx.entitlements) enable com.apple.security.app-sandbox,
         which blocks the user's existing settings folder and music outside ~/Music. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
